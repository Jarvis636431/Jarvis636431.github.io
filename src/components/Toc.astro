---
const { prefix, articleId, tocId, title = "", ariaLabel } = Astro.props;

const tocClass = `${prefix}__toc detail__toc`;
const titleClass = `${prefix}__toc-title detail__toc-title`;
const listClass = `${prefix}__toc-list detail__toc-list`;
const itemClass = `${prefix}__toc-item detail__toc-item`;
---

<aside
  class={tocClass}
  data-toc-root
  data-article-id={articleId}
  data-toc-id={tocId}
  data-item-class={itemClass}
>
  {
    title && (
      <button
        class={titleClass}
        type="button"
        data-toc-toggle
        aria-expanded="false"
        aria-controls={tocId}
      >
        <>
          <span>{title}</span>
          <span aria-hidden="true">＋</span>
        </>
      </button>
    )
  }
  <nav id={tocId} class={listClass} aria-label={ariaLabel}></nav>
</aside>

<script>
  import { initToc } from "@scripts/toc";

  initToc();
</script>

<style>
  :global(.detail__toc) {
    position: sticky;
    top: 112px;
    align-self: start;
    padding-left: 1rem;
    border-left: 1px solid rgb(var(--color-primary-rgb) / 0.13);
  }

  :global(.detail__toc-title) {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0;
    border: 0;
    background: transparent;
    font: 500 0.66rem/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-primary-rgb) / 0.45);
    margin: 0 0 1rem;
  }
  :global(.detail__toc-title span:last-child) {
    display: none;
  }

  :global(.detail__toc-list) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-height: 60vh;
    overflow-x: hidden;
    overflow-y: auto;
    padding-right: 0.375rem;
    --toc-scrollbar-thumb: rgb(var(--color-primary-rgb) / 0.16);
    scrollbar-width: thin;
    scrollbar-color: var(--toc-scrollbar-thumb) transparent;
    scrollbar-gutter: stable;
  }

  :global(.detail__toc-list:hover),
  :global(.detail__toc-list:focus-within) {
    --toc-scrollbar-thumb: rgb(var(--color-accent-rgb) / 0.45);
  }

  :global(.detail__toc-list::-webkit-scrollbar) {
    width: 5px;
  }

  :global(.detail__toc-list::-webkit-scrollbar-track) {
    background: transparent;
  }

  :global(.detail__toc-list::-webkit-scrollbar-thumb) {
    background: var(--toc-scrollbar-thumb);
    border-radius: 999px;
  }

  :global(.detail__toc-list::-webkit-scrollbar-button) {
    display: none;
  }

  :global(.detail__toc-item) {
    display: block;
    padding: 0.42rem 0 0.42rem 0.75rem;
    border-left: 2px solid transparent;
    overflow-wrap: anywhere;
    color: rgb(var(--color-primary-rgb) / 0.72);
    text-decoration: none;
    font-size: 0.78rem;
    line-height: 1.4;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  :global(.detail__toc-item::before) {
    content: none;
  }

  :global(.detail__toc .detail__toc-item.active) {
    border-left-color: var(--color-accent);
    color: var(--color-accent);
    background: transparent;
  }

  :global(.detail__toc-item:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  :global(.detail__toc .toc-depth-1) {
    padding-left: 0.75rem;
    font-weight: 600;
  }

  :global(.detail__toc .toc-depth-2) {
    padding-left: 1.5rem;
    font-size: 0.78rem;
    color: rgb(var(--color-primary-rgb) / 0.65);
  }

  :global(.detail__toc .toc-depth-3) {
    padding-left: 2.25rem;
    font-size: 0.74rem;
    color: rgb(var(--color-primary-rgb) / 0.6);
  }

  @media (max-width: 1023px) {
    :global(.detail__toc) {
      position: static;
      top: auto;
      margin-bottom: 2.5rem;
      padding: 0 0 0.9rem;
      border-left: 0;
      border-bottom: 1px solid rgb(var(--color-primary-rgb) / 0.13);
    }
    :global(.detail__toc-title) {
      margin: 0;
      cursor: pointer;
      text-align: left;
    }
    :global(.detail__toc-title span:last-child) {
      display: inline;
      color: var(--color-accent);
      font-size: 0.9rem;
    }
    :global(.detail__toc-list) {
      display: none;
      max-height: none;
      padding-top: 0.9rem;
    }
    :global(.detail__toc.toc-open .detail__toc-list) {
      display: flex;
    }
    :global(.detail__toc-item) {
      font-size: 0.85rem;
    }
  }
</style>
<!-- Astro 组件的 scoped <style> 不会匹配运行时插入的元素（例如 JS 动态生成的目录项），这些元素没有组件作用域标记，导致样式失效。解决方式：用 :global(...) 限定父容器，或直接用 Tailwind/全局样式。 -->
