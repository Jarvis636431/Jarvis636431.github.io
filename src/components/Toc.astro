---
const { prefix, articleId, tocId, title = "", ariaLabel } = Astro.props;

const tocClass = `${prefix}__toc detail__toc`;
const titleClass = `${prefix}__toc-title detail__toc-title`;
const listClass = `${prefix}__toc-list detail__toc-list`;
const itemClass = `${prefix}__toc-item detail__toc-item`;
---

<aside
  class={tocClass}
  data-toc-root
  data-article-id={articleId}
  data-toc-id={tocId}
  data-item-class={itemClass}
>
  {
    title && (
      <button
        class={titleClass}
        type="button"
        data-toc-toggle
        aria-expanded="false"
      >
        <>
          <span>{title}</span>
          <span aria-hidden="true">＋</span>
        </>
      </button>
    )
  }
  <nav id={tocId} class={listClass} aria-label={ariaLabel}></nav>
</aside>

<script is:inline>
  const runToc = () => {
    const tocRoots = document.querySelectorAll("[data-toc-root]");
    tocRoots.forEach((root) => {
      const articleId = root.getAttribute("data-article-id");
      const tocId = root.getAttribute("data-toc-id");
      const itemClass = root.getAttribute("data-item-class");
      if (!articleId || !tocId || !itemClass) return;

      const article = document.getElementById(articleId);
      const toc = document.getElementById(tocId);
      if (!article || !toc) return;

      const headings = Array.from(article.querySelectorAll("h2, h3"));
      const slugify = (s) =>
        s
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
          .replace(/^-+|-+$/g, "");
      const items = [];
      const usedIds = new Map();
      headings.forEach((h) => {
        const text = h.textContent || "";
        const baseId = h.id || slugify(text) || "section";
        const occurrence = usedIds.get(baseId) || 0;
        const id = occurrence === 0 ? baseId : `${baseId}-${occurrence + 1}`;
        usedIds.set(baseId, occurrence + 1);
        h.id = id;
        const depth = h.tagName === "H2" ? 2 : 3;
        items.push({ id, depth, text });
      });
      if (items.length < 2) {
        root.setAttribute("hidden", "");
        return;
      }
      const fragment = document.createDocumentFragment();
      items.forEach((item) => {
        const link = document.createElement("a");
        link.href = `#${item.id}`;
        link.className = `${itemClass} toc-depth-${item.depth}`;
        link.dataset.id = item.id;
        link.textContent = item.text;
        fragment.append(link);
      });
      toc.replaceChildren(fragment);
      const toggle = root.querySelector("[data-toc-toggle]");
      toggle?.addEventListener("click", () => {
        const expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!expanded));
        root.classList.toggle("toc-open", !expanded);
        const icon = toggle.lastElementChild;
        if (icon) icon.textContent = expanded ? "＋" : "−";
      });
      const links = Array.from(toc.querySelectorAll(`.${itemClass}`));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const id = entry.target.id;
            const link = toc.querySelector(`.${itemClass}[data-id="${id}"]`);
            if (link && entry.isIntersecting) {
              links.forEach((l) => {
                l.classList.remove("active");
                l.removeAttribute("aria-current");
              });
              link.classList.add("active");
              link.setAttribute("aria-current", "true");
            }
          });
        },
        { rootMargin: "0px 0px -60% 0px", threshold: 0.1 },
      );
      headings.forEach((h) => observer.observe(h));
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", runToc, { once: true });
  } else {
    runToc();
  }
</script>

<style>
  :global(.detail__toc) {
    position: sticky;
    top: 112px;
    align-self: start;
    padding-left: 1rem;
    border-left: 1px solid rgba(31, 31, 31, 0.13);
  }

  :global(.detail__toc-title) {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0;
    border: 0;
    background: transparent;
    font:
      500 0.66rem/1.4 "IBM Plex Mono",
      monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(31, 31, 31, 0.45);
    margin: 0 0 1rem;
  }
  :global(.detail__toc-title span:last-child) {
    display: none;
  }

  :global(.detail__toc-list) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-height: 60vh;
    overflow: auto;
  }

  :global(.detail__toc-item) {
    display: block;
    padding: 0.42rem 0 0.42rem 0.75rem;
    border-left: 2px solid transparent;
    color: rgba(31, 31, 31, 0.72);
    text-decoration: none;
    font-size: 0.78rem;
    line-height: 1.4;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  :global(.detail__toc-item::before) {
    content: none;
  }

  :global(.detail__toc-item.active) {
    border-left-color: #2f6f6d;
    color: #2f6f6d;
    background: transparent;
  }

  :global(.detail__toc-item:focus-visible) {
    outline: 2px solid #2f6f6d;
    outline-offset: 2px;
  }

  :global(.detail__toc .toc-depth-1) {
    font-weight: 600;
  }

  :global(.detail__toc .toc-depth-2) {
    padding-left: 0.75rem;
    font-size: 0.78rem;
    color: rgba(31, 31, 31, 0.65);
  }

  :global(.detail__toc .toc-depth-3) {
    padding-left: 1.5rem;
    font-size: 0.74rem;
    color: rgba(31, 31, 31, 0.6);
  }

  @media (max-width: 1023px) {
    :global(.detail__toc) {
      position: static;
      top: auto;
      margin-bottom: 2.5rem;
      padding: 0 0 0.9rem;
      border-left: 0;
      border-bottom: 1px solid rgba(31, 31, 31, 0.13);
    }
    :global(.detail__toc-title) {
      margin: 0;
      cursor: pointer;
      text-align: left;
    }
    :global(.detail__toc-title span:last-child) {
      display: inline;
      color: #2f6f6d;
      font-size: 0.9rem;
    }
    :global(.detail__toc-list) {
      display: none;
      max-height: none;
      padding-top: 0.9rem;
    }
    :global(.detail__toc.toc-open .detail__toc-list) {
      display: flex;
    }
    :global(.detail__toc-item) {
      font-size: 0.85rem;
    }
  }
</style>
<!-- Astro 组件的 scoped <style> 不会匹配运行时插入的元素（例如 JS 动态生成的目录项），这些元素没有组件作用域标记，导致样式失效。解决方式：用 :global(...) 限定父容器，或直接用 Tailwind/全局样式。 -->
