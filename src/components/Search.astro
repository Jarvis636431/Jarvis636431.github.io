<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-label">
  <div class="search-panel">
    <div class="search-input-row">
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
      </svg>
      <label id="search-label" class="sr-only" for="search-input"
        >Search articles and projects</label
      >
      <input
        id="search-input"
        type="search"
        placeholder="Search articles and projects…"
        autocomplete="off"
        maxlength="120"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="search-results"
        aria-describedby="search-help"
      />
      <button type="button" id="search-close" aria-label="Close search"
        >✕</button
      >
    </div>
    <div
      id="search-results"
      class="search-results"
      role="listbox"
      aria-label="Search results"
    >
    </div>
    <div class="search-footer">
      <span id="search-help">↑ ↓ Navigate · Enter Open · Esc Close</span>
      <span id="search-status" role="status" aria-live="polite"></span>
    </div>
  </div>
</dialog>

<style>
  .search-dialog {
    width: min(46rem, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: 1.5rem auto 1rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    overflow: hidden;
    opacity: 0;
    transition:
      opacity 0.3s ease,
      border-radius 0.1s ease;
    background: var(--color-background);
    color: var(--color-primary);
    box-shadow: 0 18px 64px var(--color-border-strong);
  }
  .search-dialog::backdrop {
    background: rgb(var(--color-primary-rgb) / 0.25098);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .search-dialog[data-state="open"] {
    opacity: 1;
    border-radius: 16px;
  }
  .search-dialog[data-state="open"]::backdrop {
    opacity: 1;
  }
  .search-dialog[data-state="closing"] {
    transition-delay: 0.3s, 0.1s;
  }
  .search-dialog[data-state="closing"]::backdrop {
    transition-delay: 0.3s;
  }
  .search-panel {
    display: flex;
    flex-direction: column;
    height: 56px;
    max-height: calc(100dvh - 3rem);
    transition: height 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .search-dialog[data-state="open"] .search-panel {
    height: 400px;
  }
  .search-dialog[data-state="closing"] .search-panel {
    transition-delay: 0.1s;
  }
  .search-results,
  .search-footer,
  .search-input-row input,
  #search-close {
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .search-dialog[data-state="open"] .search-results,
  .search-dialog[data-state="open"] .search-footer,
  .search-dialog[data-state="open"] input,
  .search-dialog[data-state="open"] #search-close {
    opacity: 1;
    transition-delay: 0.1s;
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-border);
    flex: none;
    height: 56px;
  }
  .search-input-row > svg {
    flex: none;
    color: var(--color-secondary);
  }
  input {
    min-width: 0;
    flex: 1;
    padding: 0.25rem 0;
    border: 0;
    outline: none;
    background: transparent;
    font: 1rem/1.5 var(--font-display);
  }
  input::placeholder {
    color: var(--color-secondary);
  }
  #search-close {
    flex: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    color: var(--color-secondary);
  }
  #search-close:hover {
    background: rgb(var(--color-primary-rgb) / 0.03922);
    color: var(--color-primary);
  }
  #search-close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .search-results {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-accent-rgb) / 0.33333) transparent;
  }
  .search-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    flex: none;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-secondary);
    font: 0.6875rem/1.5 var(--font-mono);
  }
  .search-results :global(.search-message) {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--color-secondary);
    font-size: 0.875rem;
  }
  .search-results :global(.search-result) {
    display: block;
    padding: 0.875rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    text-decoration: none;
  }
  .search-results :global(.search-result:hover),
  .search-results :global(.search-result[aria-selected="true"]) {
    border-color: rgb(var(--color-accent-rgb) / 0.14902);
    background: rgb(var(--color-accent-rgb) / 0.03137);
  }
  .search-results :global(.search-result:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .search-results :global(.search-result-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-bottom: 0.375rem;
    color: var(--color-secondary);
    font: 0.6875rem/1.5 var(--font-mono);
  }
  .search-results :global(.search-result-title) {
    margin: 0;
    color: var(--color-primary);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0;
  }
  .search-results :global(.search-result-alias) {
    margin: 0.25rem 0 0;
    color: var(--color-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .search-results :global(.search-result-excerpt) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0.375rem 0 0;
    color: var(--color-secondary);
    font: 0.875rem/1.7 var(--font-prose);
    overflow-wrap: anywhere;
  }
  .search-results :global(.search-result-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.375rem;
    color: var(--color-secondary);
    font-size: 0.6875rem;
  }
  .search-results :global(mark) {
    padding: 0;
    background: rgb(var(--color-accent-rgb) / 0.12157);
    color: var(--color-accent-hover);
    border-radius: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .search-dialog,
    .search-dialog::backdrop,
    .search-panel,
    .search-results,
    .search-footer,
    .search-input-row input,
    #search-close {
      transition: none;
    }
  }
  @media (max-width: 639px) {
    .search-dialog {
      margin-top: 1rem;
    }
    .search-panel {
      max-height: calc(100dvh - 2rem);
    }
    .search-input-row {
      padding: 0.75rem;
      gap: 0.5rem;
    }
    input {
      font-size: 1rem;
    }
    #search-help {
      font-size: 0.625rem;
    }
  }
</style>

<script>
  import { initSearch } from "@scripts/search";

  initSearch();
</script>
