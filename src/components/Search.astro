<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-label">
  <div class="search-panel">
    <div class="search-input-row">
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
      </svg>
      <label id="search-label" class="sr-only" for="search-input"
        >Search articles and projects</label
      >
      <input
        id="search-input"
        type="search"
        placeholder="Search articles and projects…"
        autocomplete="off"
        maxlength="120"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="search-results"
        aria-describedby="search-help"
      />
      <button type="button" id="search-close" aria-label="Close search"
        >✕</button
      >
    </div>
    <div
      id="search-results"
      class="search-results"
      role="listbox"
      aria-label="Search results"
    >
    </div>
    <div class="search-footer">
      <span id="search-help">↑ ↓ Navigate · Enter Open · Esc Close</span>
      <span id="search-status" role="status" aria-live="polite"></span>
    </div>
  </div>
</dialog>

<style>
  .search-dialog {
    width: min(46rem, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: 1.5rem auto 1rem;
    padding: 0;
    border: 1px solid #1f1f1f1a;
    border-radius: 20px;
    overflow: hidden;
    opacity: 0;
    transition:
      opacity 0.3s ease,
      border-radius 0.1s ease;
    background: #f6f4ef;
    color: #1f1f1f;
    box-shadow: 0 18px 64px #1f1f1f26;
  }
  .search-dialog::backdrop {
    background: #1f1f1f40;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .search-dialog[data-state="open"] {
    opacity: 1;
    border-radius: 16px;
  }
  .search-dialog[data-state="open"]::backdrop {
    opacity: 1;
  }
  .search-dialog[data-state="closing"] {
    transition-delay: 0.3s, 0.1s;
  }
  .search-dialog[data-state="closing"]::backdrop {
    transition-delay: 0.3s;
  }
  .search-panel {
    display: flex;
    flex-direction: column;
    height: 56px;
    max-height: calc(100dvh - 3rem);
    transition: height 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .search-dialog[data-state="open"] .search-panel {
    height: 400px;
  }
  .search-dialog[data-state="closing"] .search-panel {
    transition-delay: 0.1s;
  }
  .search-results,
  .search-footer,
  .search-input-row input,
  #search-close {
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .search-dialog[data-state="open"] .search-results,
  .search-dialog[data-state="open"] .search-footer,
  .search-dialog[data-state="open"] input,
  .search-dialog[data-state="open"] #search-close {
    opacity: 1;
    transition-delay: 0.1s;
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid #1f1f1f1a;
    flex: none;
    height: 56px;
  }
  .search-input-row > svg {
    flex: none;
    color: #6b6b6b;
  }
  input {
    min-width: 0;
    flex: 1;
    padding: 0.25rem 0;
    border: 0;
    outline: none;
    background: transparent;
    font:
      1rem/1.5 "Space Grotesk",
      "Noto Sans SC",
      sans-serif;
  }
  input::placeholder {
    color: #6b6b6b;
  }
  #search-close {
    flex: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    color: #6b6b6b;
  }
  #search-close:hover {
    background: #1f1f1f0a;
    color: #1f1f1f;
  }
  #search-close:focus-visible {
    outline: 2px solid #2f6f6d;
    outline-offset: 2px;
  }
  .search-results {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: #2f6f6d55 transparent;
  }
  .search-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    flex: none;
    padding: 0.75rem 1rem;
    border-top: 1px solid #1f1f1f1a;
    color: #6b6b6b;
    font:
      0.6875rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .search-results :global(.search-message) {
    padding: 2.5rem 1rem;
    text-align: center;
    color: #6b6b6b;
    font-size: 0.875rem;
  }
  .search-results :global(.search-result) {
    display: block;
    padding: 0.875rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    text-decoration: none;
  }
  .search-results :global(.search-result:hover),
  .search-results :global(.search-result[aria-selected="true"]) {
    border-color: #2f6f6d26;
    background: #2f6f6d08;
  }
  .search-results :global(.search-result:focus-visible) {
    outline: 2px solid #2f6f6d;
    outline-offset: -2px;
  }
  .search-results :global(.search-result-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-bottom: 0.375rem;
    color: #6b6b6b;
    font:
      0.6875rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .search-results :global(.search-result-title) {
    margin: 0;
    color: #1f1f1f;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0;
  }
  .search-results :global(.search-result-excerpt) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0.375rem 0 0;
    color: #6b6b6b;
    font:
      0.875rem/1.7 "Noto Sans SC",
      system-ui,
      sans-serif;
    overflow-wrap: anywhere;
  }
  .search-results :global(.search-result-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.375rem;
    color: #6b6b6b;
    font-size: 0.6875rem;
  }
  .search-results :global(mark) {
    padding: 0;
    background: #2f6f6d1f;
    color: #255a58;
    border-radius: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .search-dialog,
    .search-dialog::backdrop,
    .search-panel,
    .search-results,
    .search-footer,
    .search-input-row input,
    #search-close {
      transition: none;
    }
  }
  @media (max-width: 639px) {
    .search-dialog {
      margin-top: 1rem;
    }
    .search-panel {
      max-height: calc(100dvh - 2rem);
    }
    .search-input-row {
      padding: 0.75rem;
      gap: 0.5rem;
    }
    input {
      font-size: 1rem;
    }
    #search-help {
      font-size: 0.625rem;
    }
  }
</style>

<script>
  import { createSearch, getSearchExcerpt, type SearchItem } from "@lib/search";
  import type { FuseResult, RangeTuple } from "fuse.js";

  let fuse: ReturnType<typeof createSearch> | null = null;
  let indexPromise: Promise<boolean> | null = null;
  let selectedResultIndex = -1;
  let composing = false;
  let lastFocusedElement: HTMLElement | null = null;
  let previousOverflow = "";
  let previousPadding = "";
  let closeTimer: number | undefined;
  let openingFrame: number | undefined;
  let closing = false;
  let headerStyles = { opacity: "", pointerEvents: "", transitionDelay: "" };
  const header = document.getElementById("main-header");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const dialog = document.getElementById("search-dialog") as HTMLDialogElement;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const resultsContainer = document.getElementById("search-results")!;
  const searchStatus = document.getElementById("search-status")!;

  function renderMessage(message: string) {
    const paragraph = document.createElement("p");
    paragraph.className = "search-message";
    paragraph.textContent = message;
    resultsContainer.replaceChildren(paragraph);
    selectedResultIndex = -1;
    input.removeAttribute("aria-activedescendant");
  }

  function getResultLinks() {
    return Array.from(
      resultsContainer.querySelectorAll<HTMLAnchorElement>(
        "[data-search-result]",
      ),
    );
  }

  function updateSelectedResult(nextIndex: number, scroll = true) {
    const links = getResultLinks();
    if (!links.length) return;
    selectedResultIndex = (nextIndex + links.length) % links.length;
    links.forEach((link, index) =>
      link.setAttribute("aria-selected", String(index === selectedResultIndex)),
    );
    const selected = links[selectedResultIndex];
    input.setAttribute("aria-activedescendant", selected.id);
    if (scroll) selected.scrollIntoView({ block: "nearest" });
  }

  // Build highlights with DOM text nodes so article text can never inject HTML.
  function appendHighlighted(
    target: HTMLElement,
    text: string,
    ranges: readonly RangeTuple[] = [],
  ) {
    let cursor = 0;
    for (const [from, to] of [...ranges].sort((a, b) => a[0] - b[0])) {
      const start = Math.max(cursor, from);
      const end = Math.min(text.length, to + 1);
      if (start >= end) continue;
      target.append(document.createTextNode(text.slice(cursor, start)));
      const mark = document.createElement("mark");
      mark.textContent = text.slice(start, end);
      target.append(mark);
      cursor = end;
    }
    target.append(document.createTextNode(text.slice(cursor)));
  }

  function createResultLink(
    result: FuseResult<SearchItem>,
    index: number,
    query: string,
  ) {
    const { item, matches } = result;
    const link = document.createElement("a");
    link.href = item.slug;
    link.id = `search-result-${index}`;
    link.dataset.searchResult = "true";
    link.className = "search-result";
    link.setAttribute("role", "option");
    link.setAttribute("aria-selected", "false");

    const meta = document.createElement("div");
    meta.className = "search-result-meta";
    const type = document.createElement("span");
    type.textContent = item.collection === "blog" ? "Article" : "Project";
    meta.append(type);
    if (item.category) {
      const category = document.createElement("span");
      appendHighlighted(
        category,
        item.category,
        matches?.find((match) => match.key === "category")?.indices,
      );
      meta.append(category);
    }
    const date = document.createElement("time");
    date.dateTime = item.date;
    date.textContent = item.date.slice(0, 10);
    meta.append(date);

    const title = document.createElement("h3");
    title.className = "search-result-title";
    appendHighlighted(
      title,
      item.title,
      matches?.find((match) => match.key === "title")?.indices,
    );
    const excerpt = document.createElement("p");
    excerpt.className = "search-result-excerpt";
    const passage = getSearchExcerpt(result, query);
    appendHighlighted(excerpt, passage.text, passage.ranges);
    link.append(meta, title, excerpt);

    if (item.tags.length) {
      const tags = document.createElement("div");
      tags.className = "search-result-tags";
      const tagMatches = matches?.filter((match) => match.key === "tags") ?? [];
      const orderedTags = [...item.tags].sort(
        (a, b) =>
          Number(tagMatches.some((match) => match.value === b)) -
          Number(tagMatches.some((match) => match.value === a)),
      );
      for (const value of orderedTags.slice(0, 3)) {
        const tag = document.createElement("span");
        tag.append(document.createTextNode("#"));
        appendHighlighted(
          tag,
          value,
          tagMatches.find((match) => match.value === value)?.indices,
        );
        tags.append(tag);
      }
      link.append(tags);
    }
    link.addEventListener("pointermove", () =>
      updateSelectedResult(index, false),
    );
    link.addEventListener("focus", () => updateSelectedResult(index, false));
    return link;
  }

  async function loadIndex() {
    if (fuse) return true;
    if (indexPromise) return indexPromise;
    searchStatus.textContent = "Loading…";
    indexPromise = (async () => {
      try {
        const response = await fetch("/search-index.json");
        if (!response.ok) throw new Error("Search unavailable");
        const items = (await response.json()) as SearchItem[];
        fuse = createSearch(items);
        searchStatus.textContent = "";
        return true;
      } catch {
        searchStatus.textContent = "Unavailable";
        renderMessage("Search could not load. Type again or reopen to retry.");
        return false;
      } finally {
        indexPromise = null;
      }
    })();
    return indexPromise;
  }

  async function runSearch() {
    const query = input.value.trim();
    if (!query) {
      renderMessage("Search titles, topics, or article text.");
      searchStatus.textContent = "";
      return;
    }
    if (!fuse) {
      renderMessage("Loading search index…");
      if (!(await loadIndex())) return;
      if (!dialog.open || input.value.trim() !== query) return;
    }
    const results = fuse!.search(query, { limit: 20 });
    searchStatus.textContent =
      results.length === 20
        ? "Top 20 results"
        : `${results.length} ${results.length === 1 ? "result" : "results"}`;
    if (!results.length) {
      renderMessage("No results found. Try a different keyword.");
      return;
    }
    const fragment = document.createDocumentFragment();
    results.forEach((result, index) =>
      fragment.append(createResultLink(result, index, query)),
    );
    resultsContainer.replaceChildren(fragment);
    resultsContainer.scrollTop = 0;
    updateSelectedResult(0, false);
  }

  function clearMotion() {
    window.clearTimeout(closeTimer);
    if (openingFrame !== undefined) window.cancelAnimationFrame(openingFrame);
    closeTimer = undefined;
    openingFrame = undefined;
  }

  function openSearch() {
    if (dialog.open && !closing) return;
    clearMotion();
    closing = false;
    if (!dialog.open) {
      lastFocusedElement =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;
      previousOverflow = document.body.style.overflow;
      previousPadding = document.body.style.paddingRight;
      if (header)
        headerStyles = {
          opacity: header.style.opacity,
          pointerEvents: header.style.pointerEvents,
          transitionDelay: header.style.transitionDelay,
        };
      const scrollbarWidth =
        window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = "hidden";
      if (scrollbarWidth)
        document.body.style.paddingRight = `${scrollbarWidth}px`;
      dialog.dataset.state = "opening";
      dialog.showModal();
      renderMessage("Search titles, topics, or article text.");
    }
    if (header) {
      header.style.transitionDelay = "0s";
      header.style.opacity = "0";
      header.style.pointerEvents = "none";
    }
    input.setAttribute("aria-expanded", "true");
    input.focus();
    if (reduceMotion.matches) {
      dialog.dataset.state = "open";
    } else {
      // Paint the compact search bar before expanding, matching the original motion.
      openingFrame = requestAnimationFrame(() => {
        openingFrame = requestAnimationFrame(() => {
          openingFrame = undefined;
          if (dialog.open && !closing) dialog.dataset.state = "open";
        });
      });
    }
    void loadIndex();
  }

  function closeSearch() {
    if (!dialog.open || closing) return;
    clearMotion();
    closing = true;
    dialog.dataset.state = "closing";
    if (header) {
      header.style.transitionDelay = reduceMotion.matches ? "0s" : "0.2s";
      header.style.opacity = headerStyles.opacity;
      header.style.pointerEvents = headerStyles.pointerEvents;
    }
    if (reduceMotion.matches) dialog.close();
    else closeTimer = window.setTimeout(() => dialog.close(), 600);
  }

  document
    .getElementById("search-close")
    ?.addEventListener("click", closeSearch);
  dialog.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeSearch();
  });
  dialog.addEventListener("close", () => {
    clearMotion();
    closing = false;
    delete dialog.dataset.state;
    if (header) {
      header.style.opacity = headerStyles.opacity;
      header.style.pointerEvents = headerStyles.pointerEvents;
      header.style.transitionDelay = headerStyles.transitionDelay;
    }
    document.body.style.overflow = previousOverflow;
    document.body.style.paddingRight = previousPadding;
    input.value = "";
    input.setAttribute("aria-expanded", "false");
    input.removeAttribute("aria-activedescendant");
    searchStatus.textContent = "";
    lastFocusedElement?.focus();
  });
  dialog.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !event.isComposing) {
      event.preventDefault();
      closeSearch();
    }
  });
  dialog.addEventListener("click", (event) => {
    if (event.target !== dialog) return;
    const bounds = dialog.getBoundingClientRect();
    if (
      event.clientX < bounds.left ||
      event.clientX > bounds.right ||
      event.clientY < bounds.top ||
      event.clientY > bounds.bottom
    )
      closeSearch();
  });
  window.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (dialog.open && !closing) closeSearch();
      else openSearch();
    }
  });
  document
    .querySelectorAll("[data-search-trigger]")
    .forEach((trigger) => trigger.addEventListener("click", openSearch));
  input.addEventListener("compositionstart", () => {
    composing = true;
  });
  input.addEventListener("input", () => {
    if (!composing) void runSearch();
  });
  input.addEventListener("compositionend", () => {
    composing = false;
    void runSearch();
  });
  input.addEventListener("keydown", (event) => {
    if (event.isComposing) return;
    const links = getResultLinks();
    if (!links.length) return;
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      updateSelectedResult(
        selectedResultIndex + (event.key === "ArrowDown" ? 1 : -1),
      );
    } else if (event.key === "Enter" && selectedResultIndex >= 0) {
      event.preventDefault();
      links[selectedResultIndex]?.click();
    }
  });
</script>
