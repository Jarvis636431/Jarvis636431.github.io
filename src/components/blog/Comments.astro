---
import { integrations } from "@lib/integrations";

interface Props {
  term: string;
  title?: string;
}

const { term, title = "讨论" } = Astro.props as Props;

const comments = integrations.comments;
---

{
  comments.enabled && (comments.configured || import.meta.env.DEV) && (
    <section
      class="mt-20 border-t border-border pt-8"
      aria-labelledby="comments"
    >
      <div class="mb-6 flex items-center justify-between gap-4">
        <h2 id="comments" class="font-display text-2xl font-semibold">
          {title}
        </h2>
        <span class="font-mono text-xs uppercase tracking-wide text-secondary">
          GitHub Discussions
        </span>
      </div>

      {comments.configured ? (
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={comments.repository}
          data-repo-id={comments.repositoryId}
          data-category={comments.category}
          data-category-id={comments.categoryId}
          data-mapping="specific"
          data-term={term}
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme={comments.theme}
          data-lang={comments.language}
          crossorigin="anonymous"
          async
        />
      ) : (
        <div class="border-y border-border py-5 text-sm leading-6 text-secondary">
          评论区尚未启用，请配置 <code>PUBLIC_GISCUS_REPO_ID</code> 和{" "}
          <code>PUBLIC_GISCUS_CATEGORY_ID</code>。
        </div>
      )}
    </section>
  )
}
