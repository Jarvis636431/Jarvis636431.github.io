---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div
  id="footer-view-count"
  data-view-counter-slug={slug}
  class="hidden sm:flex items-center gap-2 opacity-0 transition-opacity duration-700"
>
  <span class="relative flex h-1.5 w-1.5">
    <span
      class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-cyan opacity-75"
    ></span>
    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-accent-cyan"
    ></span>
  </span>
  <span>
    <span id="view-count-value">--</span> Viewers
  </span>
</div>

<script>
  async function initViewCounter() {
    const container = document.getElementById("footer-view-count");
    const pageSlug = container?.dataset.viewCounterSlug;
    if (!pageSlug) return;

    const { supabase } = await import("@lib/integrations/supabase");
    if (!supabase) return;

    const viewCountEl = document.getElementById("view-count-value");

    try {
      // Increment view count using RPC
      const { data: newCount, error } = await supabase.rpc(
        "increment_page_view",
        {
          page_slug: pageSlug,
        },
      );

      if (!error && newCount !== null) {
        if (viewCountEl) viewCountEl.innerText = newCount.toLocaleString();
        if (container) container.classList.remove("opacity-0");
      }
    } catch (e) {
      console.error("Error updating view count:", e);
    }
  }

  setTimeout(initViewCounter, 1200);
</script>
