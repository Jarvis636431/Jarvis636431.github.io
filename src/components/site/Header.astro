---
import { siteConfig } from "@config/site.mjs";
export type NavLink = { href: string; label: string };

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;
---

<header
  id="main-header"
  class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur transition-opacity duration-300"
>
  <div
    class="max-w-6xl mx-auto px-4 py-2 md:py-4 flex items-center justify-between gap-6"
  >
    <a
      class="font-display font-semibold text-lg tracking-tight hover:text-accent-cyan transition-colors"
      href="/"
    >
      {siteConfig.name}
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm" aria-label="Primary">
      {
        navLinks.map(({ href, label }) => {
          const currentPath = Astro.url.pathname;
          const isActive =
            currentPath === href || currentPath.startsWith(`${href}/`);
          return (
            <a
              href={href}
              aria-current={isActive ? "page" : undefined}
              class={`transition-colors ${
                isActive ? "text-primary" : "text-secondary hover:text-primary"
              }`}
            >
              {label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center md:gap-3">
      <button
        data-search-trigger
        class="flex size-11 md:size-auto items-center justify-center text-secondary hover:text-accent-cyan transition-colors"
        aria-label="Search"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
          ></path></svg
        >
      </button>

      {
        siteConfig.github.url && (
          <a
            href={siteConfig.github.url}
            target="_blank"
            rel="noreferrer"
            class="hidden md:flex items-center justify-center text-secondary hover:text-accent-cyan transition-colors"
            aria-label="GitHub"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
            </svg>
          </a>
        )
      }

      <!-- Mobile Menu Button -->
      <button
        id="menu-btn"
        class="group flex size-11 items-center justify-center md:hidden text-secondary hover:text-accent-cyan transition-colors z-50 relative"
        aria-label="Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path class="group-aria-expanded:hidden" d="M4 6h16M4 12h16M4 18h16"
          ></path>
          <path
            class="hidden group-aria-expanded:inline"
            d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Dropdown -->
<div
  id="mobile-menu"
  class="fixed inset-x-0 top-[73px] bottom-0 z-30 bg-black/10 backdrop-blur-[2px] opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  aria-hidden="true"
  inert
>
  <nav
    class="mx-auto max-w-6xl border-b border-border bg-background/95 px-4 py-4 shadow-lg backdrop-blur"
    aria-label="Mobile navigation"
  >
    <div class="flex flex-col divide-y divide-border">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class="mobile-link flex items-center justify-between gap-3 py-4 font-display text-lg text-primary hover:text-accent-cyan transition-colors"
          >
            <span>{label}</span>
            <svg
              class="shrink-0 text-secondary"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 12h15m-6-6 6 6-6 6" />
            </svg>
          </a>
        ))
      }
    </div>
  </nav>
</div>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = mobileMenu?.querySelectorAll("a") ?? [];
  let isMenuOpen = false;
  let lastFocusedElement: HTMLElement | null = null;

  function setMenuState(open: boolean) {
    isMenuOpen = open;
    menuBtn?.setAttribute("aria-expanded", String(open));
    mobileMenu?.setAttribute("aria-hidden", String(!open));
    if (mobileMenu) mobileMenu.inert = !open;
    mobileMenu?.classList.toggle("opacity-0", !open);
    mobileMenu?.classList.toggle("pointer-events-none", !open);
  }

  function openMenu() {
    if (isMenuOpen) return;
    lastFocusedElement =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
    setMenuState(true);
    const firstFocusable = mobileLinks[0];
    if (firstFocusable instanceof HTMLElement) {
      requestAnimationFrame(() => firstFocusable.focus());
    }
  }

  function closeMenu({ restoreFocus = true }: { restoreFocus?: boolean } = {}) {
    if (!isMenuOpen) return;
    setMenuState(false);
    if (restoreFocus && lastFocusedElement instanceof HTMLElement) {
      lastFocusedElement.focus();
    }
    lastFocusedElement = null;
  }

  function toggleMenu() {
    if (isMenuOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  }

  menuBtn?.addEventListener("click", toggleMenu);
  document
    .querySelector("#main-header [data-search-trigger]")
    ?.addEventListener("click", () => closeMenu({ restoreFocus: false }), {
      capture: true,
    });

  mobileMenu?.addEventListener("click", (event) => {
    if (event.target === mobileMenu) {
      closeMenu();
    }
  });

  mobileLinks.forEach((item) => {
    item.addEventListener("click", () => closeMenu({ restoreFocus: false }));
  });

  document.addEventListener("keydown", (event) => {
    if (!isMenuOpen) return;

    if (event.key === "Escape") {
      event.preventDefault();
      closeMenu();
      return;
    }

    if (event.key !== "Tab") return;

    const focusable = Array.from(mobileLinks).filter(
      (item) => item instanceof HTMLElement && !item.hasAttribute("disabled"),
    );
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) {
      return;
    }

    const active = document.activeElement;
    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });

  window.addEventListener("resize", () => {
    if (window.matchMedia("(min-width: 768px)").matches) {
      // The desktop breakpoint may blur hidden links before the resize event.
      const menuWasOpen = isMenuOpen;
      closeMenu({ restoreFocus: false });
      if (menuWasOpen) {
        const activeLink = document.querySelector<HTMLAnchorElement>(
          '#main-header nav a[aria-current="page"]',
        );
        const firstLink =
          document.querySelector<HTMLAnchorElement>("#main-header nav a");
        (activeLink ?? firstLink)?.focus();
      }
    }
  });
</script>
