---
import { siteConfig } from "@config/site.mjs";
import ViewCounter from "@components/site/ViewCounter.astro";
import { integrations } from "@lib/integrations";

interface Props {
  viewCounterSlug?: string;
}

const { viewCounterSlug } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border mt-12 md:mt-20">
  <div
    class="max-w-6xl mx-auto px-4 py-6 md:py-8 flex flex-row justify-between items-center gap-4 text-xs sm:text-sm text-secondary"
  >
    <div class="whitespace-nowrap">© {currentYear} {siteConfig.name}</div>
    <div class="flex shrink-0 items-center gap-4 sm:gap-6">
      {
        viewCounterSlug && integrations.viewCounter.configured && (
          <ViewCounter slug={viewCounterSlug} />
        )
      }
      {
        siteConfig.github.url && (
          <a
            href={siteConfig.github.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary hover:text-accent-cyan transition-colors"
          >
            GitHub
          </a>
        )
      }
      {
        siteConfig.email && (
          <a
            href={`mailto:${siteConfig.email}`}
            class="text-secondary hover:text-accent-cyan transition-colors"
          >
            Email
          </a>
        )
      }
    </div>
  </div>
</footer>
