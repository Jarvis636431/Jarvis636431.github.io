---
import Layout from "@layouts/Layout.astro";
import {
  openSourceFocus,
  resumeExperiences,
  resumeProfile,
  resumeProjects,
  resumeSkills,
} from "../data/resume";

const siteOrigin =
  Astro.site?.origin ?? Astro.url.origin ?? "https://jarvis636431.github.io";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const updatedAtLabel = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  timeZone: "UTC",
}).format(new Date(`${resumeProfile.updatedAt}-01T00:00:00Z`));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: `${resumeProfile.name} Resume`,
  url: canonicalUrl,
  inLanguage: "en",
  mainEntity: {
    "@type": "Person",
    name: resumeProfile.name,
    jobTitle: "Software Engineer",
    email: `mailto:${resumeProfile.email}`,
    url: resumeProfile.website,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Beijing",
      addressCountry: "CN",
    },
    worksFor: {
      "@type": "Organization",
      name: resumeProfile.organization,
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "Tianjin University",
    },
    sameAs: [resumeProfile.github],
  },
};
---

<Layout
  title="Resume - Jarvis"
  lang="en"
  description="Jarvis’s resume: software engineering, AI applications, cross-platform systems, and full-stack product development."
  decorativeBackground={false}
  seo={{
    canonical: canonicalUrl,
    type: "profile",
    image: { src: "/logo.png", alt: "Jarvis" },
    structuredData,
  }}
>
  <article class="resume" aria-labelledby="resume-title">
    <div class="resume-toolbar" data-print-hidden>
      <a href="/about">← About</a>
      <div class="toolbar-actions">
        <span
          >Updated <time datetime={resumeProfile.updatedAt}
            >{updatedAtLabel}</time
          ></span
        >
        <button id="print-resume" type="button"
          >Print / Save PDF <span aria-hidden="true">↗</span></button
        >
      </div>
    </div>

    <header class="resume-hero">
      <div>
        <p class="eyebrow">Resume</p>
        <h1 id="resume-title">{resumeProfile.name}</h1>
        <p class="headline">{resumeProfile.title}</p>
      </div>
      <address class="contact-list">
        <span>{resumeProfile.location}</span>
        <a href={`mailto:${resumeProfile.email}`}>{resumeProfile.email}</a>
        <a href={resumeProfile.website}>jarvis636431.github.io</a>
        <a href={resumeProfile.github} target="_blank" rel="noopener noreferrer"
          >GitHub ↗</a
        >
      </address>
    </header>

    <section class="resume-section" aria-labelledby="profile-heading">
      <h2 id="profile-heading">Profile</h2>
      <div class="section-content">
        <p class="profile-summary">{resumeProfile.summary}</p>
        <ul class="focus-list" aria-label="Areas of focus">
          {resumeProfile.focus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="resume-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <div class="section-content entry-list">
        {
          resumeExperiences.map((experience) => (
            <article class="resume-entry">
              <div class="entry-heading">
                <h3>{experience.organization}</h3>
                <span class="entry-period">{experience.period}</span>
              </div>
              <p class="entry-role">
                {experience.role}
                {experience.location && <span> · {experience.location}</span>}
              </p>
              <p class="entry-description">{experience.summary}</p>
              <ul class="highlights">
                {experience.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
              <ul class="stack-list" aria-label="Technology stack">
                {experience.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-section" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Selected Projects</h2>
      <div class="section-content entry-list">
        {
          resumeProjects.map((project) => (
            <article class="resume-entry">
              <div class="entry-heading">
                <h3>
                  <a
                    href={project.href}
                    target={project.external ? "_blank" : undefined}
                    rel={project.external ? "noopener noreferrer" : undefined}
                  >
                    {project.name}{" "}
                    <span class="link-arrow" aria-hidden="true">
                      {project.external ? "↗" : "→"}
                    </span>
                  </a>
                </h3>
              </div>
              <p class="entry-role">{project.role}</p>
              <p class="entry-description">{project.description}</p>
              <ul class="stack-list" aria-label="Technology stack">
                {project.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <div class="section-content resume-entry">
        <h3>Tianjin University</h3>
        <p class="entry-description">
          Academic experience and hands-on work with campus technology teams.
        </p>
      </div>
    </section>

    <section class="resume-section" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      <dl class="section-content skill-groups">
        {
          resumeSkills.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.items.join(" · ")}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="resume-section" aria-labelledby="opensource-heading">
      <h2 id="opensource-heading">Open Source</h2>
      <div class="section-content">
        <div class="opensource-list">
          {
            openSourceFocus.map((project) => (
              <div class="resume-entry">
                <h3>
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.name}{" "}
                    <span class="link-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </h3>
                <p class="entry-description">{project.description}</p>
              </div>
            ))
          }
        </div>
        <a class="contributions-link" href="/contributions"
          >View contribution archive →</a
        >
      </div>
    </section>
  </article>
</Layout>

<script>
  document
    .getElementById("print-resume")
    ?.addEventListener("click", () => window.print());
</script>

<style>
  .resume {
    --resume-rule: #1f1f1f1a;
    --resume-muted: #6b6b6b;
    --resume-accent: #2f6f6d;
    --section-label-width: 9rem;
    --section-gap: 3rem;
    padding: 3rem 0 2rem;
    font-family: "Space Grotesk", "Noto Sans SC", sans-serif;
  }
  a,
  button {
    transition: color 180ms ease;
  }
  a:hover,
  button:hover {
    color: var(--resume-accent);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--resume-accent);
    outline-offset: 5px;
  }
  .resume-toolbar,
  .toolbar-actions {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }
  .resume-toolbar {
    justify-content: space-between;
    margin-bottom: 3rem;
    font-size: 0.8125rem;
  }
  .toolbar-actions > span {
    color: var(--resume-muted);
    font-size: 0.6875rem;
    font-family: "IBM Plex Mono", monospace;
  }
  .resume-toolbar button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    background: transparent;
  }
  .resume-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem;
    padding-bottom: 2.5rem;
  }
  .eyebrow {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    color: var(--resume-muted);
  }
  .resume-hero h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0;
  }
  .headline {
    margin-top: 1rem;
    color: var(--resume-muted);
    font-size: 1.125rem;
    line-height: 1.5;
  }
  .contact-list {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.375rem;
    font-style: normal;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--resume-muted);
    overflow-wrap: anywhere;
  }
  .resume-section {
    display: grid;
    grid-template-columns: var(--section-label-width) minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--section-gap);
    padding: 2rem 0;
    border-top: 1px solid var(--resume-rule);
  }
  .resume-section > h2 {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
  }
  .section-content {
    min-width: 0;
  }
  .profile-summary {
    max-width: 46rem;
    font-size: 1rem;
    line-height: 1.8;
  }
  .focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
    color: var(--resume-muted);
    font-size: 0.75rem;
    line-height: 1.7;
  }
  .entry-list {
    display: grid;
    gap: 2rem;
  }
  .resume-entry {
    min-width: 0;
  }
  .entry-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  h3 {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
  }
  .entry-period {
    flex-shrink: 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6875rem;
    line-height: 1.8;
    color: var(--resume-muted);
    font-variant-numeric: tabular-nums;
  }
  .entry-role {
    margin-top: 0.25rem;
    color: var(--resume-accent);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .entry-role span {
    color: var(--resume-muted);
  }
  .entry-description {
    margin-top: 0.75rem;
    max-width: 46rem;
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--resume-muted);
  }
  .highlights {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.75rem;
    padding-left: 1rem;
    list-style: disc;
    font-size: 0.875rem;
    line-height: 1.75;
  }
  .highlights li::marker {
    color: var(--resume-muted);
  }
  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-top: 1rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6875rem;
    line-height: 1.8;
    color: var(--resume-muted);
  }
  .link-arrow {
    display: inline-block;
    margin-left: 0.25rem;
    color: var(--resume-muted);
    font-size: 0.875rem;
  }
  .skill-groups {
    display: grid;
    gap: 1rem;
  }
  .skill-groups > div {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }
  .skill-groups dt {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .skill-groups dd {
    color: var(--resume-muted);
    font-size: 0.875rem;
    line-height: 1.8;
  }
  .opensource-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }
  .contributions-link {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--resume-accent);
    font-size: 0.8125rem;
  }
  @media screen and (max-width: 900px) {
    .resume {
      --section-label-width: 8rem;
      --section-gap: 2rem;
    }
    .entry-heading {
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
    }
    .skill-groups > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
  @media screen and (max-width: 600px) {
    .resume {
      padding-top: 2rem;
    }
    .resume-toolbar {
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .toolbar-actions {
      flex-direction: column-reverse;
      align-items: flex-end;
      gap: 0.5rem;
    }
    .resume-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding-bottom: 2rem;
    }
    .headline {
      font-size: 1rem;
    }
    .contact-list {
      align-items: flex-start;
    }
    .resume-section {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      padding: 1.5rem 0;
    }
    .resume-section > h2 {
      color: var(--resume-muted);
    }
    .entry-list {
      gap: 1.75rem;
    }
    .entry-heading {
      flex-direction: column;
      align-items: flex-start;
    }
    .opensource-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    a,
    button {
      transition: none;
    }
  }
  @page {
    size: A4;
    margin: 14mm;
  }
  @media print {
    :global(#main-header),
    :global(body > footer),
    :global(#search-dialog),
    :global(#mobile-menu),
    :global(astro-dev-toolbar),
    :global(body > a[href="#main"]),
    [data-print-hidden] {
      display: none !important;
    }
    :global(html),
    :global(body) {
      background: white !important;
      color: #1f1f1f !important;
    }
    :global(#main) {
      max-width: none !important;
      padding: 0 !important;
    }
    .resume {
      --section-label-width: 23mm;
      --section-gap: 7mm;
      padding: 0;
      font-size: 10pt;
    }
    .resume-hero {
      padding-bottom: 6mm;
      gap: 6mm;
    }
    .eyebrow {
      margin-bottom: 2mm;
      font-size: 8pt;
    }
    .resume-hero h1 {
      font-size: 32pt;
    }
    .headline {
      margin-top: 2mm;
      font-size: 11pt;
    }
    .contact-list {
      font-size: 8pt;
      gap: 1mm;
    }
    .resume-section {
      padding: 5mm 0;
    }
    .resume-section > h2 {
      font-size: 9pt;
      break-after: avoid;
    }
    .profile-summary {
      font-size: 9pt;
      line-height: 1.6;
    }
    .entry-list {
      gap: 5mm;
    }
    .resume-entry,
    .skill-groups > div {
      break-inside: avoid;
    }
    .entry-heading {
      gap: 4mm;
    }
    h3 {
      font-size: 10pt;
    }
    .entry-period,
    .stack-list,
    .focus-list {
      font-size: 7.5pt;
    }
    .entry-role,
    .entry-description,
    .highlights,
    .skill-groups dt,
    .skill-groups dd {
      font-size: 9pt;
      line-height: 1.5;
    }
    .entry-description,
    .highlights {
      margin-top: 2mm;
    }
    .stack-list {
      margin-top: 2mm;
    }
    .skill-groups {
      gap: 3mm;
    }
    .skill-groups > div {
      grid-template-columns: 31mm minmax(0, 1fr);
      gap: 4mm;
    }
    .opensource-list {
      gap: 6mm;
    }
    .contributions-link {
      font-size: 8pt;
    }
    a {
      color: inherit !important;
    }
  }
</style>
