---
import Layout from "@layouts/Layout.astro";
import { getBlogCategory } from "@lib/blog";
import { getCollection } from "astro:content";

const posts = (
  await getCollection("blog", ({ data }) =>
    import.meta.env.DEV ? true : data.draft !== true,
  )
)
  .slice()
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  );

const siteOrigin =
  Astro.site?.origin ?? Astro.url.origin ?? "https://jarvis636431.github.io";
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const blogStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Jarvis Hub Blogs",
  url: pageUrl,
  description: "关于前端工程、产品系统、AI 工具与持续学习的笔记。",
  inLanguage: "zh-CN",
};

function formatDate(date: Date, locale = "zh-CN") {
  return new Date(date).toLocaleDateString(locale, {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
}

const categoryCounts = posts.reduce((counts, post) => {
  const category = getBlogCategory(post.data.tags);
  counts.set(category, (counts.get(category) ?? 0) + 1);
  return counts;
}, new Map<string, number>());
const categoryOrder = [
  "前端",
  "AI 与算法",
  "面经",
  "项目记录",
  "周报",
  "数据库",
  "其他",
];
const categories = categoryOrder.filter((category) =>
  categoryCounts.has(category),
);
---

<Layout
  title="博客与笔记 - Jarvis Hub"
  lang="zh-CN"
  description="关于前端工程、产品系统、AI 工具与持续学习的笔记。"
  seo={{
    canonical: pageUrl,
    type: "website",
    image: {
      src: "/logo.png",
      alt: "Jarvis Hub logomark",
    },
    structuredData: blogStructuredData,
  }}
>
  <div class="blogs-page">
    <header class="blogs-header">
      <p class="blogs-kicker">Writing</p>
      <div class="blogs-heading">
        <div>
          <h1>博客与笔记</h1>
          <p>记录前端工程、产品系统、AI 工具，以及持续学习的过程。</p>
        </div>
        <div class="blogs-utility">
          <span>{posts.length} 篇公开文章</span>
          <a href="/rss.xml">RSS ↗</a>
        </div>
      </div>
    </header>

    <main>
      <div class="blog-filters" aria-label="文章分类">
        <button type="button" data-category="全部" aria-pressed="true">
          <span>全部</span><small>{posts.length}</small>
        </button>
        {
          categories.map((category) => (
            <button type="button" data-category={category} aria-pressed="false">
              <>
                <span>{category}</span>
                <small>{categoryCounts.get(category)}</small>
              </>
            </button>
          ))
        }
      </div>
      <p class="filter-result" aria-live="polite">
        <span id="visible-post-count">{posts.length}</span> 篇文章
      </p>
      {
        posts.length > 0 ? (
          <ol class="post-list" aria-label="全部文章">
            {posts.map((post) => (
              <li
                class="post-item"
                lang={post.data.language}
                data-post-category={getBlogCategory(post.data.tags)}
              >
                <a class="post-link" href={`/blogs/${post.slug}`}>
                  <time datetime={post.data.publishDate.toISOString()}>
                    {formatDate(post.data.publishDate, post.data.language)}
                  </time>

                  <div class="post-copy">
                    <h2>{post.data.title}</h2>
                    <p>{post.data.description}</p>
                  </div>

                  <div class="post-meta">
                    <span>{post.data.readingTime ?? 6} 分钟</span>
                    {post.data.tags.length > 0 && (
                      <span class="post-topic">{post.data.tags[0]}</span>
                    )}
                  </div>

                  <span class="post-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <section class="empty-state">
            <h2>暂无公开文章</h2>
            <p>正在整理内容，完成后会在这里发布。</p>
          </section>
        )
      }
      <div class="filter-empty" hidden>这个分类下暂时没有文章。</div>
    </main>
  </div>
</Layout>

<style>
  .blogs-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 4rem 0 2rem;
  }

  .blogs-header {
    padding-bottom: 3rem;
  }

  .blogs-kicker {
    margin: 0 0 1rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(31, 31, 31, 0.5);
  }

  .blogs-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
  }

  .blogs-heading h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .blogs-heading > div > p {
    margin: 1.25rem 0 0;
    max-width: 36rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(31, 31, 31, 0.62);
  }

  .blogs-utility {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 0.3rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    color: rgba(31, 31, 31, 0.5);
  }

  .blogs-utility a {
    color: #2f6f6d;
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(31, 31, 31, 0.12);
  }

  .blog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    padding: 0 0 1.15rem;
    border-bottom: 1px solid rgba(31, 31, 31, 0.12);
  }
  .blog-filters button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.3rem 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: rgba(31, 31, 31, 0.48);
    font:
      0.72rem/1.4 "IBM Plex Mono",
      monospace;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }
  .blog-filters button small {
    font-size: 0.58rem;
    color: rgba(31, 31, 31, 0.3);
  }
  .blog-filters button:hover,
  .blog-filters button[aria-pressed="true"] {
    border-bottom-color: #2f6f6d;
    color: #2f6f6d;
  }
  .blog-filters button:focus-visible {
    border-radius: 0.15rem;
    outline: 2px solid #2f6f6d;
    outline-offset: 3px;
  }
  .filter-result {
    margin: 0.9rem 0 0;
    color: rgba(31, 31, 31, 0.4);
    font:
      0.65rem/1.4 "IBM Plex Mono",
      monospace;
  }
  .filter-empty {
    padding: 3rem 0;
    border-bottom: 1px solid rgba(31, 31, 31, 0.12);
    color: rgba(31, 31, 31, 0.55);
  }

  .post-item {
    border-bottom: 1px solid rgba(31, 31, 31, 0.12);
  }

  .post-link {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 8rem 1.25rem;
    gap: 1.5rem;
    align-items: center;
    padding: 1.65rem 0;
    color: inherit;
  }

  .post-link time,
  .post-meta {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    color: rgba(31, 31, 31, 0.47);
  }

  .post-copy {
    min-width: 0;
  }

  .post-copy h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.3;
    transition: color 180ms ease;
  }

  .post-copy p {
    display: -webkit-box;
    margin: 0.5rem 0 0;
    overflow: hidden;
    color: rgba(31, 31, 31, 0.58);
    font-size: 0.9rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-end;
    text-align: right;
  }

  .post-topic {
    max-width: 8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgba(47, 111, 109, 0.8);
  }

  .post-arrow {
    color: rgba(31, 31, 31, 0.35);
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .post-link:hover h2 {
    color: #2f6f6d;
  }

  .post-link:hover .post-arrow {
    color: #2f6f6d;
    transform: translateX(3px);
  }

  .post-link:focus-visible,
  .blogs-utility a:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid #2f6f6d;
    outline-offset: 4px;
  }

  .empty-state {
    padding: 3rem 0;
    border-top: 1px solid rgba(31, 31, 31, 0.12);
    border-bottom: 1px solid rgba(31, 31, 31, 0.12);
  }

  .empty-state h2 {
    margin: 0;
    font-size: 1.4rem;
  }

  .empty-state p {
    margin: 0.5rem 0 0;
    color: rgba(31, 31, 31, 0.58);
  }

  @media (max-width: 760px) {
    .blogs-page {
      padding-top: 2.75rem;
    }

    .blogs-header {
      padding-bottom: 2.25rem;
    }

    .blogs-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .blogs-heading h1 {
      font-size: clamp(2.8rem, 14vw, 4rem);
    }

    .blogs-heading > div > p {
      margin-top: 1rem;
      font-size: 1rem;
    }

    .blogs-utility {
      width: 100%;
      justify-content: space-between;
      padding-bottom: 0;
    }

    .post-link {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      gap: 0.5rem 1rem;
      padding: 1.4rem 0;
    }

    .post-link time {
      grid-column: 1;
      grid-row: 1;
    }

    .post-copy {
      grid-column: 1;
      grid-row: 2;
    }

    .post-copy p {
      -webkit-line-clamp: 2;
    }

    .post-meta {
      grid-column: 1;
      grid-row: 3;
      flex-direction: row;
      gap: 0.8rem;
      align-items: center;
      text-align: left;
    }

    .post-arrow {
      grid-column: 2;
      grid-row: 1 / 4;
      align-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-copy h2,
    .post-arrow {
      transition: none;
    }
  }
</style>

<script>
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-category]"),
  );
  const postItems = Array.from(
    document.querySelectorAll<HTMLElement>("[data-post-category]"),
  );
  const visibleCount = document.getElementById("visible-post-count");
  const filterEmpty = document.querySelector<HTMLElement>(".filter-empty");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.dataset.category ?? "全部";
      let count = 0;
      filterButtons.forEach((item) =>
        item.setAttribute("aria-pressed", String(item === button)),
      );
      postItems.forEach((item) => {
        const visible =
          category === "全部" || item.dataset.postCategory === category;
        item.hidden = !visible;
        if (visible) count += 1;
      });
      if (visibleCount) visibleCount.textContent = String(count);
      if (filterEmpty) filterEmpty.hidden = count > 0;
    });
  });
</script>
