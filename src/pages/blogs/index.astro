---
import Layout from "@layouts/Layout.astro";
import { getBlogCategory, getPostReadingTime } from "@lib/blog";
import { getPosts } from "@lib/content";

const posts = await getPosts();
const hasDrafts = posts.some((post) => post.data.draft);
const description =
  "Notes on frontend engineering, AI applications, and building software.";
const siteOrigin =
  Astro.site?.origin ?? Astro.url.origin ?? "https://jarvis636431.github.io";
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const blogStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Jarvis Hub Blogs",
  url: pageUrl,
  description,
  inLanguage: "en",
};
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "2-digit",
  timeZone: "Asia/Shanghai",
});
// Prefix folder keys so names such as "all" cannot collide with filter controls.
const categoryKey = (category: string | null) =>
  category === null ? "root" : `folder:${category}`;
const categoryCounts = posts.reduce((counts, post) => {
  const category = getBlogCategory(post);
  counts.set(category, (counts.get(category) ?? 0) + 1);
  return counts;
}, new Map<string | null, number>());
const categories = Array.from(categoryCounts, ([name, count]) => ({
  key: categoryKey(name),
  name,
  label: name ?? "Uncategorized",
  count,
})).sort((a, b) => {
  if (a.name === null) return 1;
  if (b.name === null) return -1;
  return a.name.localeCompare(b.name, "en");
});
---

<Layout
  title="Blogs - Jarvis Hub"
  lang="en"
  description={description}
  decorativeBackground={false}
  seo={{
    canonical: pageUrl,
    type: "website",
    image: { src: "/logo.png", alt: "Jarvis Hub logomark" },
    structuredData: blogStructuredData,
  }}
>
  <div class="blogs-page">
    <header class="blogs-header">
      <div>
        <h1>Blogs</h1>
        <p>{description}</p>
      </div>
      <div class="blogs-utility">
        <span>{posts.length} {posts.length === 1 ? "article" : "articles"}</span
        >
        <a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    {
      hasDrafts && (
        <p class="preview-note">
          Development preview · Drafts are included here and hidden in
          production.
        </p>
      )
    }

    {
      posts.length > 0 ? (
        <section aria-label="Article archive" data-blog-archive>
          <div class="archive-toolbar">
            <div
              class="blog-filters"
              role="group"
              aria-label="Filter articles by topic"
            >
              <button
                type="button"
                data-category="all"
                aria-pressed="true"
                aria-controls="post-list"
              >
                <>
                  <span>All</span>
                  <small>{posts.length}</small>
                </>
              </button>
              {categories.map((category) => (
                <button
                  type="button"
                  data-category={category.key}
                  aria-pressed="false"
                  aria-controls="post-list"
                >
                  <span>{category.label}</span>
                  <small>{category.count}</small>
                </button>
              ))}
            </div>
          </div>
          <p
            class="sr-only"
            data-filter-status
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            Showing {posts.length} articles.
          </p>
          <ol id="post-list" class="post-list">
            {posts.map((post) => (
              <li
                class="post-item"
                data-post-category={categoryKey(getBlogCategory(post))}
              >
                <a class="post-link" href={`/blogs/${post.slug}`}>
                  <time datetime={post.data.publishDate.toISOString()}>
                    {dateFormatter.format(post.data.publishDate)}
                  </time>
                  <div class="post-copy">
                    <h2 lang={post.data.language}>{post.data.title}</h2>
                    <p lang={post.data.language}>{post.data.description}</p>
                    <div class="post-meta">
                      <span>{getPostReadingTime(post)} min read</span>
                      <span>{getBlogCategory(post) ?? "Uncategorized"}</span>
                      {import.meta.env.DEV && post.data.draft && (
                        <span class="draft-label">Draft</span>
                      )}
                    </div>
                  </div>
                  <span class="post-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <p class="filter-empty" hidden>
            No articles in this topic yet.
          </p>
        </section>
      ) : (
        <section class="empty-state" aria-labelledby="empty-title">
          <h2 id="empty-title">Notes are on the way.</h2>
          <p>
            I'm collecting ideas and working on new articles. In the meantime,
            take a look at my projects.
          </p>
          <a href="/projects">Explore projects →</a>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .blogs-page {
    --blog-rule: #1f1f1f1a;
    --blog-muted: #6b6b6b;
    --blog-accent: #2f6f6d;
    padding: 4rem 0 2rem;
    font-family: "Space Grotesk", "Noto Sans SC", sans-serif;
  }
  a,
  button {
    transition: color 180ms ease;
  }
  a:hover,
  button:hover {
    color: var(--blog-accent);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--blog-accent);
    outline-offset: 5px;
  }
  .blogs-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .blogs-header h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0;
  }
  .blogs-header p {
    max-width: 34rem;
    margin-top: 1rem;
    color: var(--blog-muted);
    font-size: 1rem;
    line-height: 1.75;
    text-wrap: pretty;
  }
  .blogs-utility {
    display: flex;
    align-items: baseline;
    flex-shrink: 0;
    gap: 1.5rem;
    padding-bottom: 0.25rem;
    font-size: 0.8125rem;
  }
  .blogs-utility > span {
    color: var(--blog-muted);
  }
  .blogs-utility a {
    color: var(--blog-accent);
  }
  .preview-note {
    margin: -1rem 0 2rem;
    color: var(--blog-muted);
    font-size: 0.75rem;
    line-height: 1.7;
  }
  .archive-toolbar {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--blog-rule);
  }
  .blog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .blog-filters button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.375rem 0;
    background: transparent;
    color: var(--blog-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    border-bottom: 1px solid transparent;
  }
  .blog-filters small {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.625rem;
  }
  .blog-filters button:hover,
  .blog-filters button[aria-pressed="true"] {
    color: var(--blog-accent);
  }
  .blog-filters button[aria-pressed="true"] {
    border-bottom-color: var(--blog-accent);
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-item {
    border-bottom: 1px solid var(--blog-rule);
  }
  .post-item[hidden],
  .filter-empty[hidden] {
    display: none;
  }
  .post-link {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 1.25rem;
    align-items: baseline;
    column-gap: 2rem;
    padding: 2rem 0;
  }
  .post-link time {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6875rem;
    line-height: 1.8;
    color: var(--blog-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .post-copy {
    min-width: 0;
    max-width: 44rem;
  }
  .post-copy h2 {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    transition: color 180ms ease;
  }
  .post-copy p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.5rem;
    color: var(--blog-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    font-size: 0.6875rem;
    line-height: 1.8;
    color: var(--blog-muted);
  }
  .post-meta > span:first-child {
    font-family: "IBM Plex Mono", monospace;
  }
  .draft-label {
    color: var(--blog-accent);
  }
  .post-arrow {
    justify-self: end;
    color: var(--blog-muted);
    transition:
      color 180ms ease,
      transform 180ms ease;
  }
  .post-link:hover h2 {
    color: var(--blog-accent);
  }
  .post-link:hover .post-arrow {
    color: var(--blog-accent);
    transform: translateX(3px);
  }
  .filter-empty {
    padding: 2rem 0;
    color: var(--blog-muted);
    font-size: 0.9375rem;
  }
  .empty-state {
    padding: 2.5rem 0;
    border-top: 1px solid var(--blog-rule);
    border-bottom: 1px solid var(--blog-rule);
  }
  .empty-state h2 {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
  }
  .empty-state p {
    max-width: 32rem;
    margin-top: 0.75rem;
    color: var(--blog-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
  }
  .empty-state a {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--blog-accent);
    font-size: 0.875rem;
  }
  @media (max-width: 767px) {
    .blogs-page {
      padding-top: 2.5rem;
    }
    .blogs-header {
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    .blogs-utility {
      justify-content: space-between;
      padding: 0;
    }
    .preview-note {
      margin-top: 0;
    }
    .blog-filters {
      gap: 0.5rem 1.25rem;
    }
    .blog-filters button {
      padding: 0.625rem 0;
    }
    .post-link {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      gap: 0.5rem 1rem;
      padding: 1.5rem 0;
    }
    .post-link time {
      grid-column: 1;
    }
    .post-copy {
      grid-column: 1;
    }
    .post-arrow {
      grid-column: 2;
      grid-row: 2;
    }
    .post-copy h2 {
      font-size: 1.125rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    a,
    button,
    .post-copy h2,
    .post-arrow {
      transition: none;
    }
    .post-link:hover .post-arrow {
      transform: none;
    }
  }
</style>

<script>
  const archive = document.querySelector<HTMLElement>("[data-blog-archive]");
  if (archive) {
    const buttons = Array.from(
      archive.querySelectorAll<HTMLButtonElement>("[data-category]"),
    );
    const items = Array.from(
      archive.querySelectorAll<HTMLElement>("[data-post-category]"),
    );
    const empty = archive.querySelector<HTMLElement>(".filter-empty");
    const status = archive.querySelector<HTMLElement>("[data-filter-status]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.dataset.category ?? "all";
        let count = 0;
        buttons.forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button)),
        );
        items.forEach((item) => {
          const visible =
            category === "all" || item.dataset.postCategory === category;
          item.hidden = !visible;
          if (visible) count += 1;
        });
        if (empty) empty.hidden = count > 0;
        if (status)
          status.textContent = `Showing ${count} ${count === 1 ? "article" : "articles"}${category === "all" ? "" : ` in ${button.querySelector("span")?.textContent ?? category}`}.`;
      });
    });
  }
</script>
