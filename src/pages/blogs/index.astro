---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (
  await getCollection("blog", ({ data }) =>
    import.meta.env.DEV ? true : data.draft !== true,
  )
)
  .slice()
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  );

const latestPost = posts[0];
const tags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags)),
).sort();
const years = Array.from(
  new Set(posts.map((post) => new Date(post.data.publishDate).getFullYear())),
).sort((a, b) => b - a);

const siteOrigin =
  Astro.site?.origin ?? Astro.url.origin ?? "https://jarvis636431.github.io";
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const blogStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Jarvis Hub Blogs",
  url: pageUrl,
  description: "关于前端工程、产品系统、AI 工具与持续学习的笔记。",
  inLanguage: "zh-CN",
};

function formatDate(date: Date, locale = "zh-CN") {
  return new Date(date).toLocaleDateString(locale, {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<Layout
  title="Blogs - Jarvis Hub"
  lang="en"
  description="Notes on frontend engineering, product systems, AI tools, and things I am learning."
  seo={{
    type: "website",
    image: {
      src: "/logo.png",
      alt: "Jarvis Hub logomark",
    },
    structuredData: blogStructuredData,
  }}
>
  <div class="blogs-shell">
    <header class="blogs-header">
      <div class="blogs-kicker">
        <span class="blogs-kicker__dot"></span>
        Field notes
      </div>

      <div class="blogs-header__grid">
        <div class="blogs-intro">
          <h1>Blogs</h1>
        </div>

        <aside class="blogs-stats" aria-label="Blog statistics">
          <div>
            <span>Total</span>
            <strong>{posts.length}</strong>
          </div>
          <div>
            <span>Topics</span>
            <strong>{tags.length}</strong>
          </div>
          <div>
            <span>Latest</span>
            <strong
              >{
                latestPost
                  ? formatDate(
                      latestPost.data.publishDate,
                      latestPost.data.language,
                    )
                  : "-"
              }</strong
            >
          </div>
        </aside>
      </div>

      {
        tags.length > 0 && (
          <nav class="topic-strip" aria-label="Topics">
            {tags.map((tag) => (
              <a href={`#topic-${tag}`} class="topic-chip">
                #{tag}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <main class="blogs-layout">
      <section class="post-index" aria-label="All posts">
        <div class="section-heading">
          <span>Archive</span>
          <span></span>
        </div>

        {
          posts.length > 0 ? (
            <ol class="post-list">
              {posts.map((post) => (
                <li class="post-row" lang={post.data.language}>
                  <a href={`/blogs/${post.slug}`} class="post-link">
                    <time
                      datetime={new Date(post.data.publishDate).toISOString()}
                    >
                      {formatDate(post.data.publishDate, post.data.language)}
                    </time>
                    <div class="post-main">
                      <div class="post-title-line">
                        <h2>{post.data.title}</h2>
                        <span>{post.data.readingTime ?? 5} min</span>
                      </div>
                      <p>{post.data.description}</p>
                      {post.data.tags.length > 0 && (
                        <ul>
                          {post.data.tags.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                    <span class="post-arrow" aria-hidden="true">
                      -&gt;
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <div class="empty-state">
              <h2>No posts yet</h2>
              <p>Drafts will appear here when they are ready to publish.</p>
            </div>
          )
        }
      </section>

      <aside class="notes-panel" aria-label="Blog metadata">
        <section>
          <h2>Topics</h2>
          {
            tags.length > 0 ? (
              <div class="panel-tags">
                {tags.map((tag) => (
                  <a id={`topic-${tag}`} href={`#topic-${tag}`}>
                    {tag}
                  </a>
                ))}
              </div>
            ) : (
              <p class="panel-muted">No public topics yet.</p>
            )
          }
        </section>

        <section>
          <h2>Years</h2>
          {
            years.length > 0 ? (
              <div class="year-list">
                {years.map((year) => (
                  <span>{year}</span>
                ))}
              </div>
            ) : (
              <p class="panel-muted">No public posts yet.</p>
            )
          }
        </section>

        <section>
          <h2>Feeds</h2>
          <a class="feed-link" href="/rss.xml">
            RSS feed <span aria-hidden="true">-&gt;</span>
          </a>
        </section>
      </aside>
    </main>
  </div>
</Layout>

<style>
  .blogs-shell {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .blogs-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(31, 31, 31, 0.1);
  }

  .blogs-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.5rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(31, 31, 31, 0.58);
  }

  .blogs-kicker__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #2f6f6d;
    box-shadow: 0 0 0 5px rgba(47, 111, 109, 0.12);
  }

  .blogs-header__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: 2rem;
    align-items: end;
  }

  .blogs-intro h1 {
    margin: 0;
    font-size: clamp(3.4rem, 9vw, 7rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .blogs-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(31, 31, 31, 0.1);
    background: rgba(255, 255, 255, 0.75);
    border-radius: 14px;
  }

  .blogs-stats div {
    min-width: 0;
    padding: 1rem;
    border-right: 1px solid rgba(31, 31, 31, 0.08);
  }

  .blogs-stats div:last-child {
    border-right: 0;
  }

  .blogs-stats span,
  .notes-panel h2,
  .section-heading {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(31, 31, 31, 0.5);
  }

  .blogs-stats strong {
    display: block;
    margin-top: 0.35rem;
    overflow-wrap: anywhere;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.15rem;
    line-height: 1.2;
    color: rgba(31, 31, 31, 0.9);
  }

  .topic-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .topic-chip,
  .panel-tags a,
  .post-main li {
    border: 1px solid rgba(31, 31, 31, 0.1);
    background: rgba(255, 255, 255, 0.7);
    color: rgba(31, 31, 31, 0.68);
    border-radius: 999px;
  }

  .topic-chip,
  .panel-tags a {
    padding: 0.38rem 0.72rem;
    font-size: 0.82rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  .topic-chip:hover,
  .panel-tags a:hover {
    border-color: rgba(47, 111, 109, 0.35);
    background: rgba(47, 111, 109, 0.08);
    color: #2f6f6d;
  }

  .blogs-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: 3rem;
    align-items: start;
    padding-top: 3rem;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-heading span:last-child {
    flex: 1;
    height: 1px;
    background: rgba(31, 31, 31, 0.1);
  }

  .post-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(31, 31, 31, 0.1);
  }

  .post-row {
    border-bottom: 1px solid rgba(31, 31, 31, 0.1);
  }

  .post-link {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 2rem;
    gap: 1.5rem;
    align-items: start;
    padding: 1.35rem 0;
    text-decoration: none;
    color: inherit;
  }

  .post-link time {
    padding-top: 0.3rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    color: rgba(31, 31, 31, 0.48);
  }

  .post-main {
    min-width: 0;
  }

  .post-title-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .post-title-line h2 {
    margin: 0;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .post-title-line span {
    flex: 0 0 auto;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.74rem;
    color: rgba(31, 31, 31, 0.42);
  }

  .post-main p {
    margin: 0.6rem 0 0;
    max-width: 44rem;
    color: rgba(31, 31, 31, 0.62);
    line-height: 1.65;
  }

  .post-main ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .post-main li {
    padding: 0.24rem 0.55rem;
    font-size: 0.72rem;
  }

  .post-arrow {
    padding-top: 0.25rem;
    font-family: "IBM Plex Mono", monospace;
    color: rgba(31, 31, 31, 0.36);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .post-link:hover h2 {
    color: #2f6f6d;
  }

  .post-link:hover .post-arrow {
    color: #2f6f6d;
    transform: translateX(3px);
  }

  .notes-panel {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1.5rem;
  }

  .notes-panel section {
    padding: 1rem;
    border: 1px solid rgba(31, 31, 31, 0.1);
    background: rgba(255, 255, 255, 0.62);
    border-radius: 14px;
  }

  .notes-panel h2 {
    margin: 0 0 0.8rem;
  }

  .panel-tags,
  .year-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .year-list span {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    color: rgba(31, 31, 31, 0.68);
  }

  .panel-muted {
    margin: 0;
    color: rgba(31, 31, 31, 0.55);
    font-size: 0.9rem;
  }

  .feed-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #2f6f6d;
    text-decoration: none;
    font-size: 0.92rem;
  }

  .empty-state {
    padding: 2rem;
    border: 1px solid rgba(31, 31, 31, 0.1);
    background: rgba(255, 255, 255, 0.66);
    border-radius: 16px;
  }

  .empty-state h2 {
    margin: 0;
  }

  .empty-state p {
    margin: 0.5rem 0 0;
    color: rgba(31, 31, 31, 0.58);
  }

  @media (max-width: 860px) {
    .blogs-header__grid,
    .blogs-layout {
      grid-template-columns: 1fr;
    }

    .notes-panel {
      position: static;
    }

    .post-link {
      grid-template-columns: 1fr 1.5rem;
      gap: 0.75rem;
    }

    .post-link time {
      grid-column: 1 / -1;
      padding-top: 0;
    }
  }

  @media (max-width: 560px) {
    .blogs-shell {
      padding: 2rem 0.5rem 4rem;
    }

    .blogs-stats {
      grid-template-columns: 1fr;
    }

    .blogs-stats div {
      border-right: 0;
      border-bottom: 1px solid rgba(31, 31, 31, 0.08);
    }

    .blogs-stats div:last-child {
      border-bottom: 0;
    }

    .post-title-line {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
