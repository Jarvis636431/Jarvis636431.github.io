---
import Layout from "@layouts/Layout.astro";
import Toc from "@components/Toc.astro";
import Comments from "@components/Comments.astro";
import {
  getAdjacentPosts,
  getPostReadingTime,
  getSeriesPosts,
  scoreRelatedPost,
} from "@lib/blog";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) =>
    import.meta.env.DEV ? true : data.draft !== true,
  );
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await post.render();

const publishDate = new Date(post.data.publishDate).toLocaleDateString(
  post.data.language,
  {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  },
);
const readingTime = getPostReadingTime(post);
const updatedDate = post.data.updatedDate
  ? new Date(post.data.updatedDate).toLocaleDateString(post.data.language, {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
  : undefined;
const hasUpdatedDate =
  post.data.updatedDate &&
  new Date(post.data.updatedDate).getTime() !==
    new Date(post.data.publishDate).getTime();

const publishDateIso = new Date(post.data.publishDate).toISOString();
const updatedDateIso = post.data.updatedDate
  ? new Date(post.data.updatedDate).toISOString()
  : undefined;

const siteOrigin =
  Astro.site?.origin ?? Astro.url.origin ?? "https://jarvis636431.github.io";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const articleStructuredData: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishDateIso,
  dateModified: updatedDateIso ?? publishDateIso,
  author: {
    "@type": "Person",
    name: "Jarvis Hub",
  },
  publisher: {
    "@type": "Organization",
    name: "Jarvis Hub",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.png", siteOrigin).toString(),
    },
  },
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  inLanguage: post.data.language,
};

if (post.data.tags.length > 0) {
  articleStructuredData.keywords = post.data.tags.join(", ");
}
const allPosts = (
  await getCollection("blog", ({ data }) =>
    import.meta.env.DEV ? true : data.draft !== true,
  )
)
  .slice()
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  );
const seriesPosts = getSeriesPosts(post, allPosts);
const adjacentPosts = getAdjacentPosts(post, allPosts);
const commentTerm = post.data.commentId ?? post.slug;
const commentsConfigured = Boolean(
  import.meta.env.PUBLIC_GISCUS_REPO &&
  import.meta.env.PUBLIC_GISCUS_REPO_ID &&
  import.meta.env.PUBLIC_GISCUS_CATEGORY &&
  import.meta.env.PUBLIC_GISCUS_CATEGORY_ID,
);
const titleLength = Array.from(post.data.title).length;
const titleSize =
  titleLength > 30 ? "long" : titleLength > 18 ? "medium" : "short";
const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .map((candidate) => ({
    post: candidate,
    score: scoreRelatedPost(post, candidate),
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return (
      new Date(b.post.data.publishDate).getTime() -
      new Date(a.post.data.publishDate).getTime()
    );
  })
  .slice(0, 3)
  .map(({ post }) => post);
---

<Layout
  title={`${post.data.title} - Jarvis Hub`}
  lang={post.data.language}
  description={post.data.description}
  seo={{
    canonical: canonicalUrl,
    type: "article",
    publishedTime: publishDateIso,
    modifiedTime: updatedDateIso,
    tags: post.data.tags,
    structuredData: articleStructuredData,
  }}
>
  <div
    class="fixed left-0 top-0 z-50 h-1 w-full bg-transparent"
    aria-hidden="true"
  >
    <div
      id="reading-progress"
      class="h-full w-0 bg-accent-cyan transition-[width] duration-100"
    >
    </div>
  </div>

  <article class="article-page">
    <header class="article-hero">
      <a href="/blogs" class="article-back"
        ><span aria-hidden="true">←</span> 返回博客</a
      >

      <div class="article-kicker">
        <span>Writing</span>
        {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
      </div>

      <h1 class={`article-title article-title--${titleSize}`}>
        {post.data.title}
      </h1>
      <p class="article-deck">{post.data.description}</p>

      <div class="article-meta">
        <time datetime={publishDateIso}>{publishDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} 分钟阅读</span>
        {
          hasUpdatedDate && updatedDate && (
            <>
              <>
                <span aria-hidden="true">·</span>
                <span>更新于 {updatedDate}</span>
              </>
            </>
          )
        }
        {
          (commentsConfigured || import.meta.env.DEV) && (
            <>
              <span aria-hidden="true">·</span>
              <a href="#comments">参与讨论</a>
            </>
          )
        }
      </div>

      {
        post.data.tags.length > 0 && (
          <div class="article-tags" aria-label="文章标签">
            {post.data.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        )
      }

      <div class="article-actions" aria-label="文章操作">
        <button type="button" data-share-article>
          <span aria-hidden="true">↗</span><span>分享文章</span>
        </button>
        <button type="button" data-copy-link>
          <span aria-hidden="true">⧉</span><span>复制链接</span>
        </button>
        <span
          class="article-action-status"
          data-action-status
          aria-live="polite"></span>
      </div>
    </header>

    <div class="article-rule" aria-hidden="true"></div>

    <div class="article-layout">
      <Toc
        prefix="blog"
        articleId="blog-article"
        tocId="blog-toc"
        title="本文目录"
        ariaLabel="文章目录"
      />

      <div class="article-main">
        {
          seriesPosts.length > 0 && (
            <nav class="series-index" aria-labelledby="series-title">
              <div class="series-index__heading">
                <div>
                  <span>Series</span>
                  <h2 id="series-title">{post.data.series}</h2>
                </div>
                <span>
                  {seriesPosts.findIndex((item) => item.slug === post.slug) + 1}
                  /{seriesPosts.length}
                </span>
              </div>
              <ol>
                {seriesPosts.map((item, index) => (
                  <li
                    class={item.slug === post.slug ? "is-current" : undefined}
                  >
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    {item.slug === post.slug ? (
                      <strong aria-current="page">{item.data.title}</strong>
                    ) : (
                      <a href={`/blogs/${item.slug}`}>{item.data.title}</a>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div id="blog-article" class="article-content">
          <div class="prose max-w-none"><Content /></div>
        </div>

        {
          (adjacentPosts.previous || adjacentPosts.next) && (
            <nav class="article-pagination" aria-label="文章导航">
              {adjacentPosts.previous ? (
                <a href={`/blogs/${adjacentPosts.previous.slug}`} rel="prev">
                  <span>
                    ← 上一篇{adjacentPosts.isSeries ? " · 本系列" : ""}
                  </span>
                  <strong>{adjacentPosts.previous.data.title}</strong>
                </a>
              ) : (
                <span />
              )}
              {adjacentPosts.next && (
                <a href={`/blogs/${adjacentPosts.next.slug}`} rel="next">
                  <span>
                    下一篇{adjacentPosts.isSeries ? " · 本系列" : ""} →
                  </span>
                  <strong>{adjacentPosts.next.data.title}</strong>
                </a>
              )}
            </nav>
          )
        }

        {
          relatedPosts.length > 0 && (
            <section class="related" aria-labelledby="related-posts">
              <div class="section-heading">
                <h2 id="related-posts">继续阅读</h2>
                <span>Related notes</span>
              </div>
              <div class="related-list">
                {relatedPosts.map((relatedPost) => (
                  <a href={`/blogs/${relatedPost.slug}`}>
                    <div class="related-meta">
                      <time
                        datetime={new Date(
                          relatedPost.data.publishDate,
                        ).toISOString()}
                      >
                        {new Date(
                          relatedPost.data.publishDate,
                        ).toLocaleDateString(relatedPost.data.language, {
                          year: "numeric",
                          month: "2-digit",
                          day: "2-digit",
                        })}
                      </time>
                      <span>{getPostReadingTime(relatedPost)} 分钟</span>
                    </div>
                    <h3>{relatedPost.data.title}</h3>
                    <span class="related-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <Comments term={commentTerm} />

        <footer class="article-end">
          <span>文章结束</span><a href="/blogs">查看全部文章 →</a>
        </footer>
      </div>
    </div>
  </article>

  <button
    id="back-to-top"
    class="fixed bottom-6 right-6 z-40 grid h-11 w-11 translate-y-2 place-items-center rounded-full border border-black/10 bg-surface text-primary opacity-0 shadow-lg shadow-black/10 transition-all duration-200 pointer-events-none hover:border-accent-cyan hover:text-accent-cyan focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-cyan"
    type="button"
    aria-label="Back to top"
  >
    ↑
  </button>

  <dialog class="image-lightbox" data-image-lightbox aria-label="图片预览">
    <button type="button" data-lightbox-close aria-label="关闭图片预览"
      >×</button
    >
    <figure>
      <img data-lightbox-image alt="" />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
  </dialog>
</Layout>

<style>
  .article-page {
    padding: 4rem 0 2rem;
  }
  .article-hero {
    max-width: 56rem;
    margin: 0 auto;
  }
  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3.5rem;
    color: rgba(31, 31, 31, 0.55);
    font:
      500 0.75rem/1 "IBM Plex Mono",
      monospace;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .article-back:hover {
    color: #2f6f6d;
  }
  .article-kicker {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.25rem;
    color: #2f6f6d;
    font:
      500 0.68rem/1.4 "IBM Plex Mono",
      monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .article-kicker span + span::before {
    content: "/";
    margin-right: 0.8rem;
    color: rgba(31, 31, 31, 0.24);
  }
  .article-hero h1 {
    max-width: 52rem;
    margin: 0;
    font-size: clamp(2.9rem, 7vw, 5.7rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }
  .article-title--medium {
    font-size: clamp(2.65rem, 6vw, 4.8rem);
    line-height: 1.02;
  }
  .article-title--long {
    max-width: 56rem;
    font-size: clamp(2.25rem, 5vw, 3.9rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }
  .article-deck {
    max-width: 44rem;
    margin: 1.8rem 0 0;
    color: rgba(31, 31, 31, 0.62);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    color: rgba(31, 31, 31, 0.48);
    font:
      0.7rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .article-meta a {
    color: #2f6f6d;
    text-decoration: none;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    margin-top: 1.25rem;
    color: rgba(31, 31, 31, 0.56);
    font:
      0.72rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .article-tags span::before {
    content: "#";
    margin-right: 0.12rem;
    color: rgba(47, 111, 109, 0.72);
  }
  .article-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2rem;
    margin-top: 1.5rem;
  }
  .article-actions button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(31, 31, 31, 0.58);
    font:
      500 0.7rem/1.5 "IBM Plex Mono",
      monospace;
    cursor: pointer;
  }
  .article-actions button:hover,
  .article-actions button:focus-visible {
    color: #2f6f6d;
  }
  .article-action-status {
    color: #2f6f6d;
    font:
      0.68rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .article-rule {
    max-width: 64rem;
    height: 1px;
    margin: 4rem auto;
    background: rgba(31, 31, 31, 0.13);
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(11rem, 13rem) minmax(0, 45rem);
    justify-content: center;
    gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }
  .article-main {
    min-width: 0;
  }
  .series-index {
    margin-bottom: 4rem;
    border-top: 2px solid #2f6f6d;
    border-bottom: 1px solid rgba(31, 31, 31, 0.13);
  }
  .series-index__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgba(31, 31, 31, 0.13);
  }
  .series-index__heading span {
    color: rgba(31, 31, 31, 0.45);
    font:
      0.66rem/1.4 "IBM Plex Mono",
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .series-index__heading h2 {
    margin: 0.2rem 0 0;
    font-size: 1.45rem;
  }
  .series-index ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .series-index li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgba(31, 31, 31, 0.08);
  }
  .series-index li:last-child {
    border-bottom: 0;
  }
  .series-index li > span {
    color: rgba(31, 31, 31, 0.35);
    font:
      0.68rem/1.6 "IBM Plex Mono",
      monospace;
  }
  .series-index a,
  .series-index strong {
    color: rgba(31, 31, 31, 0.68);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.45;
    text-decoration: none;
  }
  .series-index a:hover,
  .series-index .is-current strong {
    color: #2f6f6d;
  }
  .series-index .is-current > span {
    color: #2f6f6d;
  }
  .article-content {
    min-width: 0;
  }
  .related {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(31, 31, 31, 0.13);
  }
  .article-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(31, 31, 31, 0.13);
  }
  .article-pagination a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .article-pagination a:last-child {
    text-align: right;
  }
  .article-pagination span {
    color: rgba(31, 31, 31, 0.42);
    font:
      0.66rem/1.4 "IBM Plex Mono",
      monospace;
  }
  .article-pagination strong {
    font-size: 1rem;
    line-height: 1.4;
  }
  .article-pagination a:hover strong {
    color: #2f6f6d;
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 0.75rem;
  }
  .section-heading h2 {
    margin: 0;
    font-size: 1.55rem;
  }
  .section-heading span {
    color: rgba(31, 31, 31, 0.42);
    font:
      0.66rem/1 "IBM Plex Mono",
      monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .related-list {
    border-top: 1px solid rgba(31, 31, 31, 0.1);
  }
  .related-list > a {
    position: relative;
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 1.5rem;
    gap: 1.25rem;
    align-items: center;
    padding: 1.3rem 0;
    border-bottom: 1px solid rgba(31, 31, 31, 0.1);
    color: inherit;
    text-decoration: none;
  }
  .related-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: rgba(31, 31, 31, 0.44);
    font:
      0.66rem/1.4 "IBM Plex Mono",
      monospace;
  }
  .related-list h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.35;
    transition: color 180ms ease;
  }
  .related-arrow {
    color: rgba(31, 31, 31, 0.35);
    transition:
      transform 180ms ease,
      color 180ms ease;
  }
  .related-list > a:hover h3,
  .related-list > a:hover .related-arrow {
    color: #2f6f6d;
  }
  .related-list > a:hover .related-arrow {
    transform: translateX(3px);
  }
  .article-end {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(31, 31, 31, 0.13);
    color: rgba(31, 31, 31, 0.45);
    font:
      0.7rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .article-end a {
    color: #2f6f6d;
    text-decoration: none;
  }

  :global(.prose pre) {
    position: relative;
    max-height: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  :global(.code-toolbar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.5rem;
    margin: -1rem -1rem 1rem;
    padding: 0 0.75rem 0 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.035);
  }
  :global(.code-identity) {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
  }
  :global(.code-filename) {
    overflow: hidden;
    color: rgba(255, 255, 255, 0.82);
    font:
      0.68rem/1 "IBM Plex Mono",
      monospace;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.code-language) {
    color: rgba(255, 255, 255, 0.42);
    font:
      0.62rem/1 "IBM Plex Mono",
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.prose pre code) {
    background: transparent;
    padding: 0;
  }

  :global(.code-copy-button) {
    flex: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.78);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    line-height: 1;
    padding: 0.45rem 0.65rem;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  :global(.code-copy-button[data-state="error"]) {
    border-color: rgba(255, 160, 140, 0.48);
    color: #ffc1b4;
  }
  :global(.code-fold-button) {
    position: absolute;
    right: 0.75rem;
    bottom: 0.65rem;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: #24292e;
    color: rgba(255, 255, 255, 0.8);
    padding: 0.4rem 0.65rem;
    font:
      0.64rem/1 "IBM Plex Mono",
      monospace;
    cursor: pointer;
  }
  :global(.prose pre.is-collapsible:not(.is-expanded)) {
    max-height: 30rem;
    overflow: hidden;
  }
  :global(.prose pre.is-collapsible:not(.is-expanded)::after) {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 7rem;
    background: linear-gradient(transparent, #24292e 78%);
    pointer-events: none;
  }
  :global(.prose pre.code-with-lines code) {
    counter-reset: code-line;
  }
  :global(.prose pre.code-with-lines .line) {
    display: inline-block;
    width: 100%;
    min-height: 1.45em;
  }
  :global(.prose pre.code-with-lines .line::before) {
    counter-increment: code-line;
    content: counter(code-line);
    display: inline-block;
    width: 2.5rem;
    margin-right: 1rem;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.28);
    text-align: right;
    padding-right: 0.75rem;
    user-select: none;
  }
  :global(.prose pre .line.is-highlighted) {
    margin-left: -1rem;
    width: calc(100% + 2rem);
    padding-left: 0.85rem;
    border-left: 2px solid #62b3af;
    background: rgba(98, 179, 175, 0.12);
  }

  :global(.code-copy-button:hover),
  :global(.code-copy-button:focus-visible) {
    border-color: rgba(255, 255, 255, 0.34);
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  :global(.prose a[data-external-link]::after) {
    content: "↗";
    display: inline-block;
    margin-left: 0.18em;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72em;
    transform: translateY(-0.08em);
  }

  :global(.prose img) {
    height: auto;
    border: 1px solid rgba(31, 31, 31, 0.12);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: none;
  }
  :global(.article-figure) {
    margin: 2.5rem 0;
  }
  :global(.article-image-button) {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  :global(.article-image-button img) {
    width: 100%;
    margin: 0;
  }
  :global(.article-figure figcaption) {
    margin-top: 0.7rem;
    color: rgba(31, 31, 31, 0.5);
    font:
      0.72rem/1.5 "IBM Plex Mono",
      monospace;
    text-align: center;
  }
  .image-lightbox {
    width: min(94vw, 90rem);
    max-width: none;
    height: min(92vh, 70rem);
    max-height: none;
    padding: 3rem;
    border: 0;
    background: rgba(16, 19, 18, 0.96);
    color: #fff;
  }
  .image-lightbox::backdrop {
    background: rgba(10, 12, 12, 0.78);
    backdrop-filter: blur(8px);
  }
  .image-lightbox > button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font-size: 1.25rem;
    cursor: pointer;
  }
  .image-lightbox figure {
    display: grid;
    height: 100%;
    margin: 0;
    place-items: center;
  }
  .image-lightbox img {
    max-width: 100%;
    max-height: calc(100% - 3rem);
    object-fit: contain;
  }
  .image-lightbox figcaption {
    color: rgba(255, 255, 255, 0.68);
    font:
      0.72rem/1.5 "IBM Plex Mono",
      monospace;
  }

  :global(.article-content .prose) {
    max-width: 100%;
  }
  :global(.article-content .prose h2),
  :global(.article-content .prose h3) {
    scroll-margin-top: 7rem;
  }
  :global(.article-content .prose table) {
    display: table;
    min-width: 100%;
  }
  :global(.table-scroll) {
    width: 100%;
    margin: 2em 0;
    overflow-x: auto;
    border-top: 1px solid rgba(31, 31, 31, 0.12);
    border-bottom: 1px solid rgba(31, 31, 31, 0.12);
  }
  :global(.table-scroll table) {
    margin: 0;
  }
  :global(.heading-anchor) {
    margin-left: 0.45rem;
    color: rgba(47, 111, 109, 0.42);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.65em;
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition:
      opacity 160ms ease,
      color 160ms ease;
  }
  :global(.article-content h2:hover .heading-anchor),
  :global(.article-content h3:hover .heading-anchor),
  :global(.heading-anchor:focus-visible) {
    color: #2f6f6d;
    opacity: 1;
  }
  :global(.prose input[type="checkbox"]) {
    margin-right: 0.55rem;
    accent-color: #2f6f6d;
  }

  @media (max-width: 1023px) {
    .article-layout {
      display: block;
      max-width: 45rem;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .article-page {
      padding-top: 2.5rem;
    }
    .article-back {
      margin-bottom: 2.5rem;
    }
    .article-hero h1 {
      font-size: clamp(2.55rem, 13vw, 4rem);
    }
    .article-title--medium {
      font-size: clamp(2.3rem, 11vw, 3.35rem);
    }
    .article-title--long {
      font-size: clamp(2rem, 9.5vw, 2.85rem);
      line-height: 1.12;
    }
    .article-deck {
      margin-top: 1.35rem;
      font-size: 1rem;
    }
    .article-rule {
      margin: 2.75rem 0;
    }
    .related-list > a {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      gap: 0.5rem 1rem;
    }
    .related-meta {
      grid-column: 1;
      flex-direction: row;
      gap: 0.75rem;
    }
    .related-list h3 {
      grid-column: 1;
    }
    .related-arrow {
      grid-column: 2;
      grid-row: 1 / 3;
    }
    .section-heading span {
      display: none;
    }
    .article-actions {
      flex-wrap: wrap;
    }
    .article-action-status {
      width: 100%;
    }
    .article-pagination {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .article-pagination a:last-child {
      text-align: left;
    }
    .image-lightbox {
      width: 100vw;
      height: 100vh;
      padding: 3.5rem 1rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #reading-progress,
    #back-to-top,
    :global(.code-copy-button) {
      transition: none;
    }
    .article-back,
    .related-list h3,
    .related-arrow {
      transition: none;
    }
  }
</style>

<script>
  const progress = document.getElementById("reading-progress");
  const backToTop = document.getElementById("back-to-top");
  const article = document.getElementById("blog-article");

  function updateReadingProgress() {
    if (!progress || !article) return;

    const articleTop = article.offsetTop;
    const articleHeight = article.offsetHeight;
    const viewportHeight = window.innerHeight;
    const readableHeight = Math.max(articleHeight - viewportHeight * 0.65, 1);
    const current = window.scrollY - articleTop;
    const percent = Math.min(Math.max(current / readableHeight, 0), 1) * 100;
    progress.style.width = `${percent}%`;
  }

  function updateBackToTop() {
    if (!backToTop) return;
    const visible = window.scrollY > window.innerHeight * 0.8;
    backToTop.classList.toggle("opacity-0", !visible);
    backToTop.classList.toggle("pointer-events-none", !visible);
    backToTop.classList.toggle("translate-y-2", !visible);
  }

  function enhanceArticleLinks() {
    if (!article) return;

    article.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
      const href = link.getAttribute("href");
      if (!href || href.startsWith("#")) return;

      const url = new URL(href, window.location.href);
      if (url.origin !== window.location.origin) {
        link.dataset.externalLink = "true";
        link.target = "_blank";
        link.rel = "noopener noreferrer";
      }
    });
  }

  function enhanceCodeBlocks() {
    if (!article) return;

    const parseHighlightedLines = (value: string) => {
      const lines = new Set<number>();
      value.split(",").forEach((part) => {
        const [start, end = start] = part.split("-").map(Number);
        if (!Number.isFinite(start) || !Number.isFinite(end)) return;
        for (let line = start; line <= end; line += 1) lines.add(line);
      });
      return lines;
    };

    const copyText = async (value: string) => {
      if (!window.navigator.clipboard?.writeText)
        throw new Error("Copy is unavailable");
      await window.navigator.clipboard.writeText(value);
    };

    article.querySelectorAll("pre").forEach((pre) => {
      if (pre.querySelector(".code-copy-button")) return;
      const code = pre.querySelector("code");
      if (!code?.textContent) return;

      const meta = code.dataset.codeMeta ?? pre.dataset.codeMeta ?? "";
      const filename = meta.match(/(?:title|filename)=["']([^"']+)["']/)?.[1];
      const highlightExpression = meta.match(/\{([\d,\s-]+)\}/)?.[1] ?? "";
      const showLineNumbers =
        /(?:^|\s)(?:lineNumbers|showLineNumbers)(?:\s|$)/i.test(meta);
      const forceCollapse = /(?:^|\s)collapse(?:\s|$)/i.test(meta);
      const languageClass = Array.from(code.classList).find((className) =>
        className.startsWith("language-"),
      );

      const toolbar = document.createElement("div");
      toolbar.className = "code-toolbar";
      const identity = document.createElement("span");
      identity.className = "code-identity";
      if (filename) {
        const filenameLabel = document.createElement("span");
        filenameLabel.className = "code-filename";
        filenameLabel.textContent = filename;
        identity.append(filenameLabel);
      }
      if (languageClass) {
        const language = document.createElement("span");
        language.className = "code-language";
        language.textContent = languageClass.replace("language-", "");
        identity.append(language);
      }
      toolbar.append(identity);

      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy-button";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "复制代码");
      button.addEventListener("click", async () => {
        try {
          await copyText(code.textContent ?? "");
          button.dataset.state = "success";
          button.textContent = "Copied";
        } catch {
          button.dataset.state = "error";
          button.textContent = "复制失败";
        }
        setTimeout(() => {
          button.textContent = "Copy";
          delete button.dataset.state;
        }, 1600);
      });
      toolbar.append(button);
      pre.prepend(toolbar);

      const lines = Array.from(code.querySelectorAll<HTMLElement>(".line"));
      if (showLineNumbers && lines.length > 0)
        pre.classList.add("code-with-lines");
      const highlightedLines = parseHighlightedLines(highlightExpression);
      lines.forEach((line, index) => {
        if (highlightedLines.has(index + 1))
          line.classList.add("is-highlighted");
      });

      if ((forceCollapse || lines.length > 24) && lines.length > 0) {
        pre.classList.add("is-collapsible");
        const foldButton = document.createElement("button");
        foldButton.type = "button";
        foldButton.className = "code-fold-button";
        foldButton.textContent = `展开 ${lines.length} 行代码`;
        foldButton.setAttribute("aria-expanded", "false");
        foldButton.addEventListener("click", () => {
          const expanded = pre.classList.toggle("is-expanded");
          foldButton.setAttribute("aria-expanded", String(expanded));
          foldButton.textContent = expanded
            ? "收起代码"
            : `展开 ${lines.length} 行代码`;
        });
        pre.append(foldButton);
      }
    });
  }

  function enhanceArticleImages() {
    if (!article) return;
    const lightbox = document.querySelector<HTMLDialogElement>(
      "[data-image-lightbox]",
    );
    const preview = lightbox?.querySelector<HTMLImageElement>(
      "[data-lightbox-image]",
    );
    const caption = lightbox?.querySelector<HTMLElement>(
      "[data-lightbox-caption]",
    );

    const openImage = (image: HTMLImageElement) => {
      if (!lightbox || !preview || !caption) return;
      preview.src = image.currentSrc || image.src;
      preview.alt = image.alt;
      caption.textContent =
        image.closest("figure")?.querySelector("figcaption")?.textContent ??
        image.alt;
      lightbox.showModal();
    };

    article.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
      image.loading = "lazy";
      image.decoding = "async";
      const setIntrinsicDimensions = () => {
        if (!image.hasAttribute("width") && image.naturalWidth)
          image.width = image.naturalWidth;
        if (!image.hasAttribute("height") && image.naturalHeight)
          image.height = image.naturalHeight;
      };
      if (image.complete) setIntrinsicDimensions();
      else
        image.addEventListener("load", setIntrinsicDimensions, { once: true });

      const parent = image.parentElement;
      if (parent?.matches("[data-article-image]")) {
        parent.addEventListener("click", () => openImage(image));
        return;
      }
      if (!parent || parent.tagName !== "P" || parent.children.length !== 1)
        return;

      const figure = document.createElement("figure");
      figure.className = "article-figure";
      const zoomButton = document.createElement("button");
      zoomButton.type = "button";
      zoomButton.className = "article-image-button";
      zoomButton.setAttribute(
        "aria-label",
        `放大图片：${image.alt || "文章图片"}`,
      );
      parent.before(figure);
      zoomButton.append(image);
      figure.append(zoomButton);
      if (image.alt) {
        const figureCaption = document.createElement("figcaption");
        figureCaption.textContent = image.alt;
        figure.append(figureCaption);
      }
      parent.remove();

      zoomButton.addEventListener("click", () => openImage(image));
    });

    lightbox
      ?.querySelector("[data-lightbox-close]")
      ?.addEventListener("click", () => lightbox.close());
    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) lightbox.close();
    });
  }

  function setupArticleActions() {
    const shareButton = document.querySelector<HTMLButtonElement>(
      "[data-share-article]",
    );
    const copyButton =
      document.querySelector<HTMLButtonElement>("[data-copy-link]");
    const status = document.querySelector<HTMLElement>("[data-action-status]");
    let statusTimer: number | undefined;
    const announce = (message: string) => {
      if (!status) return;
      status.textContent = message;
      window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => (status.textContent = ""), 2200);
    };
    const copyUrl = async () => {
      try {
        await window.navigator.clipboard.writeText(window.location.href);
        announce("链接已复制");
      } catch {
        announce("复制失败，请从地址栏复制");
      }
    };

    copyButton?.addEventListener("click", copyUrl);
    if (!window.navigator.share) shareButton?.setAttribute("hidden", "");
    shareButton?.addEventListener("click", async () => {
      try {
        await window.navigator.share({
          title: document.title,
          text: document.querySelector<HTMLMetaElement>(
            'meta[name="description"]',
          )?.content,
          url: window.location.href,
        });
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError")
          return;
        await copyUrl();
      }
    });
  }

  function enhanceTablesAndHeadings() {
    if (!article) return;

    article.querySelectorAll("table").forEach((table) => {
      if (table.parentElement?.classList.contains("table-scroll")) return;
      const wrapper = document.createElement("div");
      wrapper.className = "table-scroll";
      wrapper.tabIndex = 0;
      wrapper.setAttribute("role", "region");
      wrapper.setAttribute("aria-label", "可横向滚动的数据表格");
      table.before(wrapper);
      wrapper.append(table);
    });

    article
      .querySelectorAll<HTMLElement>("h2[id], h3[id]")
      .forEach((heading) => {
        if (heading.querySelector(".heading-anchor")) return;
        const anchor = document.createElement("a");
        anchor.className = "heading-anchor";
        anchor.href = `#${heading.id}`;
        anchor.textContent = "#";
        anchor.setAttribute(
          "aria-label",
          `链接到“${heading.textContent?.trim() ?? "本节"}”`,
        );
        heading.append(anchor);
      });
  }

  window.addEventListener("scroll", () => {
    updateReadingProgress();
    updateBackToTop();
  });
  window.addEventListener("resize", updateReadingProgress);
  backToTop?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  enhanceArticleLinks();
  enhanceCodeBlocks();
  enhanceArticleImages();
  enhanceTablesAndHeadings();
  setupArticleActions();
  updateReadingProgress();
  updateBackToTop();
</script>
