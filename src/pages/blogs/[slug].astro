---
import Layout from "@layouts/Layout.astro";
import Toc from "@components/Toc.astro";
import Comments from "@components/Comments.astro";
import { getPostReadingTime, scoreRelatedPost } from "@lib/blog";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) =>
    import.meta.env.DEV ? true : data.draft !== true,
  );
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await post.render();

const publishDate = new Date(post.data.publishDate).toLocaleDateString(
  post.data.language,
  {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  },
);
const readingTime = getPostReadingTime(post);
const updatedDate = post.data.updatedDate
  ? new Date(post.data.updatedDate).toLocaleDateString(post.data.language, {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
  : undefined;
const hasUpdatedDate =
  post.data.updatedDate &&
  new Date(post.data.updatedDate).getTime() !==
    new Date(post.data.publishDate).getTime();

const publishDateIso = new Date(post.data.publishDate).toISOString();
const updatedDateIso = post.data.updatedDate
  ? new Date(post.data.updatedDate).toISOString()
  : undefined;

const siteOrigin =
  Astro.site?.origin ?? Astro.url.origin ?? "https://jarvis636431.github.io";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const articleStructuredData: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishDateIso,
  dateModified: updatedDateIso ?? publishDateIso,
  author: {
    "@type": "Person",
    name: "Jarvis Hub",
  },
  publisher: {
    "@type": "Organization",
    name: "Jarvis Hub",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.png", siteOrigin).toString(),
    },
  },
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  inLanguage: post.data.language,
};

if (post.data.tags.length > 0) {
  articleStructuredData.keywords = post.data.tags.join(", ");
}
const allPosts = (
  await getCollection("blog", ({ data }) =>
    import.meta.env.DEV ? true : data.draft !== true,
  )
)
  .slice()
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  );
const commentTerm = post.data.commentId ?? post.slug;
const commentsConfigured = Boolean(
  import.meta.env.PUBLIC_GISCUS_REPO &&
  import.meta.env.PUBLIC_GISCUS_REPO_ID &&
  import.meta.env.PUBLIC_GISCUS_CATEGORY &&
  import.meta.env.PUBLIC_GISCUS_CATEGORY_ID,
);
const titleLength = Array.from(post.data.title).length;
const titleSize =
  titleLength > 30 ? "long" : titleLength > 18 ? "medium" : "short";
const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .map((candidate) => ({
    post: candidate,
    score: scoreRelatedPost(post, candidate),
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return (
      new Date(b.post.data.publishDate).getTime() -
      new Date(a.post.data.publishDate).getTime()
    );
  })
  .slice(0, 3)
  .map(({ post }) => post);
---

<Layout
  title={`${post.data.title} - Jarvis Hub`}
  lang={post.data.language}
  description={post.data.description}
  seo={{
    canonical: canonicalUrl,
    type: "article",
    publishedTime: publishDateIso,
    modifiedTime: updatedDateIso,
    tags: post.data.tags,
    structuredData: articleStructuredData,
  }}
>
  <div
    class="fixed left-0 top-0 z-50 h-1 w-full bg-transparent"
    aria-hidden="true"
  >
    <div
      id="reading-progress"
      class="h-full w-0 bg-accent-cyan transition-[width] duration-100"
    >
    </div>
  </div>

  <article class="article-page">
    <header class="article-hero">
      <a href="/blogs" class="article-back"
        ><span aria-hidden="true">←</span> 返回博客</a
      >

      <div class="article-kicker">
        <span>Writing</span>
        {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
      </div>

      <h1 class={`article-title article-title--${titleSize}`}>
        {post.data.title}
      </h1>
      <p class="article-deck">{post.data.description}</p>

      <div class="article-meta">
        <time datetime={publishDateIso}>{publishDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} 分钟阅读</span>
        {
          hasUpdatedDate && updatedDate && (
            <>
              <>
                <span aria-hidden="true">·</span>
                <span>更新于 {updatedDate}</span>
              </>
            </>
          )
        }
        {
          (commentsConfigured || import.meta.env.DEV) && (
            <>
              <span aria-hidden="true">·</span>
              <a href="#comments">参与讨论</a>
            </>
          )
        }
      </div>

      {
        post.data.tags.length > 0 && (
          <div class="article-tags" aria-label="文章标签">
            {post.data.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="article-rule" aria-hidden="true"></div>

    <div class="article-layout">
      <Toc
        prefix="blog"
        articleId="blog-article"
        tocId="blog-toc"
        title="本文目录"
        ariaLabel="文章目录"
      />

      <div class="article-main">
        <div id="blog-article" class="article-content">
          <div class="prose max-w-none"><Content /></div>
        </div>

        {
          relatedPosts.length > 0 && (
            <section class="related" aria-labelledby="related-posts">
              <div class="section-heading">
                <h2 id="related-posts">继续阅读</h2>
                <span>Related notes</span>
              </div>
              <div class="related-list">
                {relatedPosts.map((relatedPost) => (
                  <a href={`/blogs/${relatedPost.slug}`}>
                    <div class="related-meta">
                      <time
                        datetime={new Date(
                          relatedPost.data.publishDate,
                        ).toISOString()}
                      >
                        {new Date(
                          relatedPost.data.publishDate,
                        ).toLocaleDateString(relatedPost.data.language, {
                          year: "numeric",
                          month: "2-digit",
                          day: "2-digit",
                        })}
                      </time>
                      <span>{getPostReadingTime(relatedPost)} 分钟</span>
                    </div>
                    <h3>{relatedPost.data.title}</h3>
                    <span class="related-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <Comments term={commentTerm} />

        <footer class="article-end">
          <span>文章结束</span><a href="/blogs">查看全部文章 →</a>
        </footer>
      </div>
    </div>
  </article>

  <button
    id="back-to-top"
    class="fixed bottom-6 right-6 z-40 grid h-11 w-11 translate-y-2 place-items-center rounded-full border border-black/10 bg-surface text-primary opacity-0 shadow-lg shadow-black/10 transition-all duration-200 pointer-events-none hover:border-accent-cyan hover:text-accent-cyan focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-cyan"
    type="button"
    aria-label="Back to top"
  >
    ↑
  </button>
</Layout>

<style>
  .article-page {
    padding: 4rem 0 2rem;
  }
  .article-hero {
    max-width: 56rem;
    margin: 0 auto;
  }
  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3.5rem;
    color: rgba(31, 31, 31, 0.55);
    font:
      500 0.75rem/1 "IBM Plex Mono",
      monospace;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .article-back:hover {
    color: #2f6f6d;
  }
  .article-kicker {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.25rem;
    color: #2f6f6d;
    font:
      500 0.68rem/1.4 "IBM Plex Mono",
      monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .article-kicker span + span::before {
    content: "/";
    margin-right: 0.8rem;
    color: rgba(31, 31, 31, 0.24);
  }
  .article-hero h1 {
    max-width: 52rem;
    margin: 0;
    font-size: clamp(2.9rem, 7vw, 5.7rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }
  .article-title--medium {
    font-size: clamp(2.65rem, 6vw, 4.8rem);
    line-height: 1.02;
  }
  .article-title--long {
    max-width: 56rem;
    font-size: clamp(2.25rem, 5vw, 3.9rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }
  .article-deck {
    max-width: 44rem;
    margin: 1.8rem 0 0;
    color: rgba(31, 31, 31, 0.62);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    color: rgba(31, 31, 31, 0.48);
    font:
      0.7rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .article-meta a {
    color: #2f6f6d;
    text-decoration: none;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    margin-top: 1.25rem;
    color: rgba(31, 31, 31, 0.56);
    font:
      0.72rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .article-tags span::before {
    content: "#";
    margin-right: 0.12rem;
    color: rgba(47, 111, 109, 0.72);
  }
  .article-rule {
    max-width: 64rem;
    height: 1px;
    margin: 4rem auto;
    background: rgba(31, 31, 31, 0.13);
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(11rem, 13rem) minmax(0, 45rem);
    justify-content: center;
    gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }
  .article-main {
    min-width: 0;
  }
  .article-content {
    min-width: 0;
  }
  .related {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(31, 31, 31, 0.13);
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 0.75rem;
  }
  .section-heading h2 {
    margin: 0;
    font-size: 1.55rem;
  }
  .section-heading span {
    color: rgba(31, 31, 31, 0.42);
    font:
      0.66rem/1 "IBM Plex Mono",
      monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .related-list {
    border-top: 1px solid rgba(31, 31, 31, 0.1);
  }
  .related-list > a {
    position: relative;
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 1.5rem;
    gap: 1.25rem;
    align-items: center;
    padding: 1.3rem 0;
    border-bottom: 1px solid rgba(31, 31, 31, 0.1);
    color: inherit;
    text-decoration: none;
  }
  .related-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: rgba(31, 31, 31, 0.44);
    font:
      0.66rem/1.4 "IBM Plex Mono",
      monospace;
  }
  .related-list h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.35;
    transition: color 180ms ease;
  }
  .related-arrow {
    color: rgba(31, 31, 31, 0.35);
    transition:
      transform 180ms ease,
      color 180ms ease;
  }
  .related-list > a:hover h3,
  .related-list > a:hover .related-arrow {
    color: #2f6f6d;
  }
  .related-list > a:hover .related-arrow {
    transform: translateX(3px);
  }
  .article-end {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(31, 31, 31, 0.13);
    color: rgba(31, 31, 31, 0.45);
    font:
      0.7rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .article-end a {
    color: #2f6f6d;
    text-decoration: none;
  }

  :global(.prose pre) {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  :global(.code-language) {
    position: absolute;
    top: 0.85rem;
    left: 1rem;
    color: rgba(255, 255, 255, 0.42);
    font:
      0.62rem/1 "IBM Plex Mono",
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.prose pre code) {
    background: transparent;
    padding: 0;
  }

  :global(.code-copy-button) {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.78);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    line-height: 1;
    padding: 0.45rem 0.65rem;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  :global(.code-copy-button:hover),
  :global(.code-copy-button:focus-visible) {
    border-color: rgba(255, 255, 255, 0.34);
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  :global(.prose a[data-external-link]::after) {
    content: "↗";
    display: inline-block;
    margin-left: 0.18em;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72em;
    transform: translateY(-0.08em);
  }

  :global(.prose img) {
    border: 1px solid rgba(31, 31, 31, 0.12);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: none;
  }

  :global(.article-content .prose) {
    max-width: 100%;
  }
  :global(.article-content .prose h2),
  :global(.article-content .prose h3) {
    scroll-margin-top: 7rem;
  }
  :global(.article-content .prose table) {
    display: table;
    min-width: 100%;
  }
  :global(.table-scroll) {
    width: 100%;
    margin: 2em 0;
    overflow-x: auto;
    border-top: 1px solid rgba(31, 31, 31, 0.12);
    border-bottom: 1px solid rgba(31, 31, 31, 0.12);
  }
  :global(.table-scroll table) {
    margin: 0;
  }
  :global(.heading-anchor) {
    margin-left: 0.45rem;
    color: rgba(47, 111, 109, 0.42);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.65em;
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition:
      opacity 160ms ease,
      color 160ms ease;
  }
  :global(.article-content h2:hover .heading-anchor),
  :global(.article-content h3:hover .heading-anchor),
  :global(.heading-anchor:focus-visible) {
    color: #2f6f6d;
    opacity: 1;
  }
  :global(.prose input[type="checkbox"]) {
    margin-right: 0.55rem;
    accent-color: #2f6f6d;
  }

  @media (max-width: 1023px) {
    .article-layout {
      display: block;
      max-width: 45rem;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .article-page {
      padding-top: 2.5rem;
    }
    .article-back {
      margin-bottom: 2.5rem;
    }
    .article-hero h1 {
      font-size: clamp(2.55rem, 13vw, 4rem);
    }
    .article-title--medium {
      font-size: clamp(2.3rem, 11vw, 3.35rem);
    }
    .article-title--long {
      font-size: clamp(2rem, 9.5vw, 2.85rem);
      line-height: 1.12;
    }
    .article-deck {
      margin-top: 1.35rem;
      font-size: 1rem;
    }
    .article-rule {
      margin: 2.75rem 0;
    }
    .related-list > a {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      gap: 0.5rem 1rem;
    }
    .related-meta {
      grid-column: 1;
      flex-direction: row;
      gap: 0.75rem;
    }
    .related-list h3 {
      grid-column: 1;
    }
    .related-arrow {
      grid-column: 2;
      grid-row: 1 / 3;
    }
    .section-heading span {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #reading-progress,
    #back-to-top,
    :global(.code-copy-button) {
      transition: none;
    }
    .article-back,
    .related-list h3,
    .related-arrow {
      transition: none;
    }
  }
</style>

<script>
  const progress = document.getElementById("reading-progress");
  const backToTop = document.getElementById("back-to-top");
  const article = document.getElementById("blog-article");

  function updateReadingProgress() {
    if (!progress || !article) return;

    const articleTop = article.offsetTop;
    const articleHeight = article.offsetHeight;
    const viewportHeight = window.innerHeight;
    const readableHeight = Math.max(articleHeight - viewportHeight * 0.65, 1);
    const current = window.scrollY - articleTop;
    const percent = Math.min(Math.max(current / readableHeight, 0), 1) * 100;
    progress.style.width = `${percent}%`;
  }

  function updateBackToTop() {
    if (!backToTop) return;
    const visible = window.scrollY > window.innerHeight * 0.8;
    backToTop.classList.toggle("opacity-0", !visible);
    backToTop.classList.toggle("pointer-events-none", !visible);
    backToTop.classList.toggle("translate-y-2", !visible);
  }

  function enhanceArticleLinks() {
    if (!article) return;

    article.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
      const href = link.getAttribute("href");
      if (!href || href.startsWith("#")) return;

      const url = new URL(href, window.location.href);
      if (url.origin !== window.location.origin) {
        link.dataset.externalLink = "true";
        link.target = "_blank";
        link.rel = "noopener noreferrer";
      }
    });
  }

  function enhanceCodeBlocks() {
    if (!article || !window.navigator.clipboard) return;

    article.querySelectorAll("pre").forEach((pre) => {
      if (pre.querySelector(".code-copy-button")) return;

      const code = pre.querySelector("code");
      if (!code?.textContent) return;

      const languageClass = Array.from(code.classList).find((className) =>
        className.startsWith("language-"),
      );
      if (languageClass) {
        const language = document.createElement("span");
        language.className = "code-language";
        language.textContent = languageClass.replace("language-", "");
        pre.append(language);
      }

      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy-button";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy code");
      button.addEventListener("click", async () => {
        await window.navigator.clipboard.writeText(code.textContent ?? "");
        button.textContent = "Copied";
        setTimeout(() => {
          button.textContent = "Copy";
        }, 1600);
      });

      pre.append(button);
    });
  }

  function enhanceTablesAndHeadings() {
    if (!article) return;

    article.querySelectorAll("table").forEach((table) => {
      if (table.parentElement?.classList.contains("table-scroll")) return;
      const wrapper = document.createElement("div");
      wrapper.className = "table-scroll";
      wrapper.tabIndex = 0;
      wrapper.setAttribute("role", "region");
      wrapper.setAttribute("aria-label", "可横向滚动的数据表格");
      table.before(wrapper);
      wrapper.append(table);
    });

    article
      .querySelectorAll<HTMLElement>("h2[id], h3[id]")
      .forEach((heading) => {
        if (heading.querySelector(".heading-anchor")) return;
        const anchor = document.createElement("a");
        anchor.className = "heading-anchor";
        anchor.href = `#${heading.id}`;
        anchor.textContent = "#";
        anchor.setAttribute(
          "aria-label",
          `链接到“${heading.textContent?.trim() ?? "本节"}”`,
        );
        heading.append(anchor);
      });
  }

  window.addEventListener("scroll", () => {
    updateReadingProgress();
    updateBackToTop();
  });
  window.addEventListener("resize", updateReadingProgress);
  backToTop?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  enhanceArticleLinks();
  enhanceCodeBlocks();
  enhanceTablesAndHeadings();
  updateReadingProgress();
  updateBackToTop();
</script>
