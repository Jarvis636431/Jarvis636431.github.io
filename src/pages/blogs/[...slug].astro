---
import Layout from "@layouts/Layout.astro";
import "@styles/article.css";
import Toc from "@components/Toc.astro";
import Comments from "@components/Comments.astro";
import {
  getAdjacentPosts,
  getPostReadingTime,
  getSeriesPosts,
  getRelatedPosts,
} from "@lib/blog";
import type { CollectionEntry } from "astro:content";
import { getPosts } from "@lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await post.render();

const publishDate = new Date(post.data.publishDate).toLocaleDateString(
  post.data.language,
  {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  },
);
const readingTime = getPostReadingTime(post);
const updatedDate = post.data.updatedDate
  ? new Date(post.data.updatedDate).toLocaleDateString(post.data.language, {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
  : undefined;
const hasUpdatedDate =
  post.data.updatedDate &&
  new Date(post.data.updatedDate).getTime() !==
    new Date(post.data.publishDate).getTime();

const publishDateIso = new Date(post.data.publishDate).toISOString();
const updatedDateIso = post.data.updatedDate
  ? new Date(post.data.updatedDate).toISOString()
  : undefined;

const siteOrigin =
  Astro.site?.origin ?? Astro.url.origin ?? "https://jarvis636431.github.io";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const articleStructuredData: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishDateIso,
  dateModified: updatedDateIso ?? publishDateIso,
  author: {
    "@type": "Person",
    name: "Jarvis Hub",
  },
  publisher: {
    "@type": "Organization",
    name: "Jarvis Hub",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.png", siteOrigin).toString(),
    },
  },
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  inLanguage: post.data.language,
};

if (post.data.tags.length > 0) {
  articleStructuredData.keywords = post.data.tags.join(", ");
}
const allPosts = await getPosts();
const seriesPosts = getSeriesPosts(post, allPosts);
const adjacentPosts = getAdjacentPosts(post, allPosts);
const commentTerm = post.data.commentId ?? post.slug;
const commentsConfigured = Boolean(
  import.meta.env.PUBLIC_GISCUS_REPO &&
  import.meta.env.PUBLIC_GISCUS_REPO_ID &&
  import.meta.env.PUBLIC_GISCUS_CATEGORY &&
  import.meta.env.PUBLIC_GISCUS_CATEGORY_ID,
);
const titleLength = Array.from(post.data.title).length;
const titleSize =
  titleLength > 30 ? "long" : titleLength > 18 ? "medium" : "short";
const relatedPosts = getRelatedPosts(post, allPosts);
---

<Layout
  title={`${post.data.title} - Jarvis Hub`}
  lang={post.data.language}
  description={post.data.description}
  seo={{
    canonical: canonicalUrl,
    type: "article",
    publishedTime: publishDateIso,
    modifiedTime: updatedDateIso,
    tags: post.data.tags,
    structuredData: articleStructuredData,
  }}
>
  <div
    class="fixed left-0 top-0 z-50 h-1 w-full bg-transparent"
    aria-hidden="true"
  >
    <div
      id="reading-progress"
      class="h-full w-0 bg-accent-cyan transition-[width] duration-100"
    >
    </div>
  </div>

  <article class="article-page">
    <header class="article-hero">
      <div class="article-topline">
        <a href="/blogs" class="article-back"
          ><span aria-hidden="true">←</span> 返回博客</a
        >
        <div class="article-kicker">
          <span>Writing</span>
          {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
        </div>
      </div>

      <h1
        class={`article-title article-title--${titleSize}`}
        title={post.data.title}
      >
        {post.data.title}
      </h1>
      <p class="article-deck">{post.data.description}</p>

      <div class="article-meta">
        <time datetime={publishDateIso}>{publishDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} 分钟阅读</span>
        {
          hasUpdatedDate && updatedDate && (
            <>
              <>
                <span aria-hidden="true">·</span>
                <span>更新于 {updatedDate}</span>
              </>
            </>
          )
        }
        {
          (commentsConfigured || import.meta.env.DEV) && (
            <>
              <span aria-hidden="true">·</span>
              <a href="#comments">参与讨论</a>
            </>
          )
        }
      </div>

      <div class="article-footer">
        {
          post.data.tags.length > 0 && (
            <div class="article-tags" aria-label="文章标签">
              {post.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          )
        }

        <div class="article-actions" aria-label="文章操作">
          <button type="button" data-share-article>
            <span aria-hidden="true">↗</span><span>分享文章</span>
          </button>
          <button type="button" data-copy-link>
            <span aria-hidden="true">⧉</span><span>复制链接</span>
          </button>
          <span
            class="article-action-status"
            data-action-status
            aria-live="polite"></span>
        </div>
      </div>
    </header>

    <div class="article-rule" aria-hidden="true"></div>

    <div class="article-layout">
      <Toc
        prefix="blog"
        articleId="blog-article"
        tocId="blog-toc"
        title="本文目录"
        ariaLabel="文章目录"
      />

      <div class="article-main">
        {
          seriesPosts.length > 0 && (
            <nav class="series-index" aria-labelledby="series-title">
              <div class="series-index__heading">
                <div>
                  <span>Series</span>
                  <h2 id="series-title">{post.data.series}</h2>
                </div>
                <span>
                  {seriesPosts.findIndex((item) => item.slug === post.slug) + 1}
                  /{seriesPosts.length}
                </span>
              </div>
              <ol>
                {seriesPosts.map((item, index) => (
                  <li
                    class={item.slug === post.slug ? "is-current" : undefined}
                  >
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    {item.slug === post.slug ? (
                      <strong aria-current="page">{item.data.title}</strong>
                    ) : (
                      <a href={`/blogs/${item.slug}`}>{item.data.title}</a>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div id="blog-article" class="article-content">
          <div class="prose max-w-none"><Content /></div>
        </div>

        {
          (adjacentPosts.previous || adjacentPosts.next) && (
            <nav class="article-pagination" aria-label="文章导航">
              {adjacentPosts.previous ? (
                <a href={`/blogs/${adjacentPosts.previous.slug}`} rel="prev">
                  <span>
                    ← 上一篇{adjacentPosts.isSeries ? " · 本系列" : ""}
                  </span>
                  <strong>{adjacentPosts.previous.data.title}</strong>
                </a>
              ) : (
                <span />
              )}
              {adjacentPosts.next && (
                <a href={`/blogs/${adjacentPosts.next.slug}`} rel="next">
                  <span>
                    下一篇{adjacentPosts.isSeries ? " · 本系列" : ""} →
                  </span>
                  <strong>{adjacentPosts.next.data.title}</strong>
                </a>
              )}
            </nav>
          )
        }

        {
          relatedPosts.length > 0 && (
            <section class="related" aria-labelledby="related-posts">
              <div class="section-heading">
                <h2 id="related-posts">继续阅读</h2>
                <span>Related notes</span>
              </div>
              <div class="related-list">
                {relatedPosts.map((relatedPost) => (
                  <a href={`/blogs/${relatedPost.slug}`}>
                    <div class="related-meta">
                      <time
                        datetime={new Date(
                          relatedPost.data.publishDate,
                        ).toISOString()}
                      >
                        {new Date(
                          relatedPost.data.publishDate,
                        ).toLocaleDateString(relatedPost.data.language, {
                          year: "numeric",
                          month: "2-digit",
                          day: "2-digit",
                        })}
                      </time>
                      <span>{getPostReadingTime(relatedPost)} 分钟</span>
                    </div>
                    <h3>{relatedPost.data.title}</h3>
                    <span class="related-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <Comments term={commentTerm} />

        <footer class="article-end">
          <span>文章结束</span><a href="/blogs">查看全部文章 →</a>
        </footer>
      </div>
    </div>
  </article>

  <button
    id="back-to-top"
    class="fixed bottom-6 right-6 z-40 grid h-11 w-11 translate-y-2 place-items-center rounded-full border border-border bg-surface text-primary opacity-0 shadow-lg shadow-black/10 transition-all duration-200 pointer-events-none hover:border-accent-cyan hover:text-accent-cyan focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-cyan"
    type="button"
    aria-label="Back to top"
  >
    ↑
  </button>

  <dialog class="image-lightbox" data-image-lightbox aria-label="图片预览">
    <button type="button" data-lightbox-close aria-label="关闭图片预览"
      >×</button
    >
    <figure>
      <img data-lightbox-image alt="" />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
  </dialog>
</Layout>

<style>
  .article-page {
    padding: 2.5rem 0 2rem;
  }
  .article-hero {
    max-width: 56rem;
    margin: 0 auto;
  }
  .article-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgb(var(--color-primary-rgb) / 0.55);
    font: 500 0.75rem/1 var(--font-mono);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .article-back:hover {
    color: var(--color-accent);
  }
  .article-kicker {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-accent);
    font: 500 0.68rem/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .article-kicker span + span::before {
    content: "/";
    margin-right: 0.8rem;
    color: rgb(var(--color-primary-rgb) / 0.24);
  }
  .article-hero h1 {
    --title-min: 1.75rem;
    --title-fluid: 4.5vw;
    --title-max: 4rem;
    display: -webkit-box;
    max-width: 52rem;
    margin: 0;
    font-size: clamp(var(--title-min), var(--title-fluid), var(--title-max));
    line-height: 1.2;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .article-hero .article-title--medium {
    --title-min: 1.625rem;
    --title-fluid: 3.75vw;
    --title-max: 3.25rem;
  }
  .article-hero .article-title--long {
    --title-min: 1.5rem;
    --title-fluid: 3vw;
    --title-max: 2.75rem;
  }
  .article-deck {
    max-width: 48rem;
    margin: 1rem 0 0;
    color: rgb(var(--color-primary-rgb) / 0.62);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.7;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    color: rgb(var(--color-primary-rgb) / 0.48);
    font: 0.7rem/1.5 var(--font-mono);
  }
  .article-meta a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .article-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    color: rgb(var(--color-primary-rgb) / 0.56);
    font: 0.72rem/1.5 var(--font-mono);
  }
  .article-tags span::before {
    content: "#";
    margin-right: 0.12rem;
    color: rgb(var(--color-accent-rgb) / 0.72);
  }
  .article-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    min-height: 2rem;
  }
  .article-actions button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgb(var(--color-primary-rgb) / 0.58);
    font: 500 0.7rem/1.5 var(--font-mono);
    cursor: pointer;
  }
  .article-actions button:hover,
  .article-actions button:focus-visible {
    color: var(--color-accent);
  }
  .article-action-status {
    color: var(--color-accent);
    font: 0.68rem/1.5 var(--font-mono);
  }
  .article-action-status:empty {
    display: none;
  }
  .article-rule {
    max-width: 64rem;
    height: 1px;
    margin: 2rem auto;
    background: rgb(var(--color-primary-rgb) / 0.13);
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(15rem, 17rem) minmax(0, 45rem);
    justify-content: start;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }
  .article-main {
    min-width: 0;
  }
  .series-index {
    margin-bottom: 4rem;
    border-top: 2px solid var(--color-accent);
    border-bottom: 1px solid rgb(var(--color-primary-rgb) / 0.13);
  }
  .series-index__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgb(var(--color-primary-rgb) / 0.13);
  }
  .series-index__heading span {
    color: rgb(var(--color-primary-rgb) / 0.45);
    font: 0.66rem/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .series-index__heading h2 {
    margin: 0.2rem 0 0;
    font-size: 1.45rem;
  }
  .series-index ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .series-index li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgb(var(--color-primary-rgb) / 0.08);
  }
  .series-index li:last-child {
    border-bottom: 0;
  }
  .series-index li > span {
    color: rgb(var(--color-primary-rgb) / 0.35);
    font: 0.68rem/1.6 var(--font-mono);
  }
  .series-index a,
  .series-index strong {
    color: rgb(var(--color-primary-rgb) / 0.68);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.45;
    text-decoration: none;
  }
  .series-index a:hover,
  .series-index .is-current strong {
    color: var(--color-accent);
  }
  .series-index .is-current > span {
    color: var(--color-accent);
  }
  .article-content {
    min-width: 0;
  }
  .related {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-primary-rgb) / 0.13);
  }
  .article-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(var(--color-primary-rgb) / 0.13);
  }
  .article-pagination a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .article-pagination a:last-child {
    text-align: right;
  }
  .article-pagination span {
    color: rgb(var(--color-primary-rgb) / 0.42);
    font: 0.66rem/1.4 var(--font-mono);
  }
  .article-pagination strong {
    font-size: 1rem;
    line-height: 1.4;
  }
  .article-pagination a:hover strong {
    color: var(--color-accent);
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 0.75rem;
  }
  .section-heading h2 {
    margin: 0;
    font-size: 1.55rem;
  }
  .section-heading span {
    color: rgb(var(--color-primary-rgb) / 0.42);
    font: 0.66rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .related-list {
    border-top: 1px solid rgb(var(--color-primary-rgb) / 0.1);
  }
  .related-list > a {
    position: relative;
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 1.5rem;
    gap: 1.25rem;
    align-items: center;
    padding: 1.3rem 0;
    border-bottom: 1px solid rgb(var(--color-primary-rgb) / 0.1);
    color: inherit;
    text-decoration: none;
  }
  .related-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: rgb(var(--color-primary-rgb) / 0.44);
    font: 0.66rem/1.4 var(--font-mono);
  }
  .related-list h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.35;
    transition: color 180ms ease;
  }
  .related-arrow {
    color: rgb(var(--color-primary-rgb) / 0.35);
    transition:
      transform 180ms ease,
      color 180ms ease;
  }
  .related-list > a:hover h3,
  .related-list > a:hover .related-arrow {
    color: var(--color-accent);
  }
  .related-list > a:hover .related-arrow {
    transform: translateX(3px);
  }
  .article-end {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(var(--color-primary-rgb) / 0.13);
    color: rgb(var(--color-primary-rgb) / 0.45);
    font: 0.7rem/1.5 var(--font-mono);
  }
  .article-end a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .image-lightbox {
    width: min(94vw, 90rem);
    max-width: none;
    height: min(92vh, 70rem);
    max-height: none;
    padding: 3rem;
    border: 0;
    background: rgba(16, 19, 18, 0.96);
    color: var(--color-surface);
  }
  .image-lightbox::backdrop {
    background: rgba(10, 12, 12, 0.78);
    backdrop-filter: blur(8px);
  }
  .image-lightbox > button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgb(var(--color-surface-rgb) / 0.22);
    border-radius: 999px;
    background: transparent;
    color: var(--color-surface);
    font-size: 1.25rem;
    cursor: pointer;
  }
  .image-lightbox figure {
    display: grid;
    height: 100%;
    margin: 0;
    place-items: center;
  }
  .image-lightbox img {
    max-width: 100%;
    max-height: calc(100% - 3rem);
    object-fit: contain;
  }
  .image-lightbox figcaption {
    color: rgb(var(--color-surface-rgb) / 0.68);
    font: 0.72rem/1.5 var(--font-mono);
  }

  @media (max-width: 1023px) {
    .article-layout {
      display: block;
      max-width: 45rem;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .article-page {
      padding-top: 1.75rem;
    }
    .article-topline {
      margin-bottom: 1rem;
    }
    .article-deck {
      margin-top: 0.75rem;
      font-size: 1rem;
    }
    .article-rule {
      margin: 1.5rem 0;
    }
    .related-list > a {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      gap: 0.5rem 1rem;
    }
    .related-meta {
      grid-column: 1;
      flex-direction: row;
      gap: 0.75rem;
    }
    .related-list h3 {
      grid-column: 1;
    }
    .related-arrow {
      grid-column: 2;
      grid-row: 1 / 3;
    }
    .section-heading span {
      display: none;
    }
    .article-actions {
      flex-wrap: wrap;
    }
    .article-action-status {
      width: 100%;
    }
    .article-pagination {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .article-pagination a:last-child {
      text-align: left;
    }
    .image-lightbox {
      width: 100vw;
      height: 100vh;
      padding: 3.5rem 1rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #reading-progress,
    #back-to-top {
      transition: none;
    }
    .article-back,
    .related-list h3,
    .related-arrow {
      transition: none;
    }
  }
</style>

<script>
  import { initArticle } from "@scripts/article";

  initArticle();
</script>
