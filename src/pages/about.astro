---
import Layout from "@layouts/Layout.astro";
import { resumeProfile } from "../data/resume";

const description =
  "Software engineer at JD.com, focused on AI applications, cross-platform engineering, and developer tools.";
const experiences = [
  {
    period: "2026 — Present",
    organization: "JD.com",
    role: "Software Engineer",
  },
  {
    period: "2025",
    organization: "Tenio · Tianjin University",
    role: "Frontend Developer",
  },
  {
    period: "2023 — 2024",
    organization: "iDesignLab · Tianjin University",
    role: "Full-stack Developer",
  },
  {
    period: "2022",
    organization: "TWT Studio · Tianjin University",
    role: "Cross-platform Developer",
  },
];

const pageUrl = new URL(
  "/about",
  Astro.site ?? "https://jarvis636431.github.io",
).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: pageUrl,
  inLanguage: "en",
  mainEntity: {
    "@type": "Person",
    name: resumeProfile.name,
    description,
    jobTitle: "Software Engineer",
    email: `mailto:${resumeProfile.email}`,
    worksFor: { "@type": "Organization", name: "JD.com" },
    alumniOf: { "@type": "CollegeOrUniversity", name: "Tianjin University" },
    sameAs: [resumeProfile.github],
  },
};
---

<Layout
  title="About - Jarvis Hub"
  lang="en"
  description={description}
  seo={{ canonical: pageUrl, type: "profile", structuredData }}
>
  <article class="about-page">
    <header class="about-intro">
      <h1>I'm Jarvis.</h1>
      <p class="about-lead">Software engineer at JD.com, based in Beijing.</p>
      <p>
        I studied at Tianjin University and built campus apps and full-stack
        products. Today, I focus on AI applications, cross-platform engineering,
        and developer tools, and contribute to open source.
      </p>
      <p>Outside of work, I explore new product ideas and play Apex Legends.</p>
      <nav class="about-links" aria-label="Profile and contact links">
        <a href="/resume">View resume</a>
        <a href={resumeProfile.github} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
        <a href={`mailto:${resumeProfile.email}`}>Get in touch</a>
      </nav>
    </header>

    <section class="about-section" aria-labelledby="experience-title">
      <h2 id="experience-title">Experience</h2>
      <dl class="experience-list">
        {
          experiences.map((experience) => (
            <div>
              <dt>{experience.period}</dt>
              <dd>
                <h3>{experience.organization}</h3>
                <p>{experience.role}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="about-section" aria-labelledby="contributions-title">
      <h2 id="contributions-title">Open-source contributions</h2>
      <div class="contribution-links">
        <div>
          <h3>SwitchHosts</h3>
          <a
            href="https://github.com/oldj/SwitchHosts/pull/1051"
            target="_blank"
            rel="noopener noreferrer"
          >
            <strong
              >#1051 · Show the macOS tray panel over full-screen apps</strong
            >
            <span
              >Used a non-activating native panel to display the tray window
              above full-screen apps, and corrected mouse event handling to
              prevent accidental dismissal on pointer movement.</span
            >
            <time datetime="2026-09-30">September 30, 2026</time>
          </a>
        </div>
        <div>
          <h3>Taro</h3>
          <a
            href="https://github.com/NervJS/taro/pull/19459"
            target="_blank"
            rel="noopener noreferrer"
          >
            <strong
              >#19459 · Fix template aliases after removing event listeners</strong
            >
            <span
              >Aligned template selection with node initialization to prevent
              mini-program runtime crashes when Text and Image nodes lose their
              last event listener.</span
            >
            <time datetime="2026-07-21">July 21, 2026</time>
          </a>
          <a
            href="https://github.com/NervJS/taro/pull/19273"
            target="_blank"
            rel="noopener noreferrer"
          >
            <strong
              >#19273 · Support project initialization in the current directory</strong
            >
            <span
              >Added support for taro init ., deriving the project name from the
              current directory, with tests for path resolution and
              initialization.</span
            >
            <time datetime="2026-07-17">July 17, 2026</time>
          </a>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  .about-page {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 0;
  }
  .about-intro h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 600;
    line-height: 1.15;
  }
  .about-intro p {
    max-width: 38rem;
    margin: 0.75rem 0;
    color: #666;
    font-size: 1rem;
    line-height: 1.85;
  }
  .about-intro .about-lead {
    color: #1f1f1f;
    font-size: 1.2rem;
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
  .about-links a {
    color: #2f6f6d;
    font-size: 0.9rem;
    text-underline-offset: 0.3em;
  }
  .about-section {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(31, 31, 31, 0.12);
  }
  .about-section h2 {
    margin: 0 0 1.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .experience-list {
    display: grid;
    gap: 1.4rem;
    margin: 0;
  }
  .experience-list > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
  }
  .experience-list dt {
    color: #666;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .experience-list dd {
    margin: 0;
  }
  .experience-list h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
  }
  .experience-list p {
    margin: 0.3rem 0 0;
    color: #666;
    font-size: 0.85rem;
  }
  .contribution-links {
    display: grid;
    gap: 1.25rem;
  }
  .contribution-links h3 {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .contribution-links a {
    display: grid;
    gap: 0.5rem;
  }
  .contribution-links a + a {
    margin-top: 1.25rem;
  }
  .contribution-links time {
    color: #666;
    font-size: 0.8rem;
  }
  .contribution-links strong {
    font-weight: 500;
  }
  .contribution-links span {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  a:focus-visible {
    outline: 2px solid #2f6f6d;
    outline-offset: 5px;
  }
  @media (max-width: 480px) {
    .experience-list > div {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
