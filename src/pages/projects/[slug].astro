---
import Layout from "@layouts/Layout.astro";
import Toc from "@components/Toc.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) =>
    import.meta.env.DEV ? true : data.status !== "archived",
  );
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content } = await project.render();

const publishDate = new Date(project.data.publishDate).toLocaleDateString(
  project.data.language,
  {
    year: "numeric",
    month: "long",
  },
);

const updatedDate = project.data.updatedDate
  ? new Date(project.data.updatedDate).toLocaleDateString(
      project.data.language,
      {
        year: "numeric",
        month: "long",
      },
    )
  : undefined;

const publishDateIso = new Date(project.data.publishDate).toISOString();
const updatedDateIso = project.data.updatedDate
  ? new Date(project.data.updatedDate).toISOString()
  : undefined;

const siteOrigin =
  Astro.site?.origin ?? Astro.url.origin ?? "https://jarvis636431.github.io";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const coverImageUrl = project.data.coverImage
  ? new URL(project.data.coverImage, siteOrigin).toString()
  : undefined;

const projectStructuredData: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.summary,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  datePublished: publishDateIso,
  dateModified: updatedDateIso ?? publishDateIso,
  inLanguage: project.data.language,
  creator: {
    "@type": "Person",
    name: "Jarvis Hub",
  },
};

if (project.data.roles.length > 0) {
  projectStructuredData.about = project.data.roles.join(", ");
}

if (project.data.stack.length > 0) {
  projectStructuredData.keywords = project.data.stack.join(", ");
}

if (coverImageUrl) {
  projectStructuredData.image = [coverImageUrl];
}

if (project.data.externalUrl) {
  projectStructuredData.sameAs = [project.data.externalUrl];
}
// Compute previous/next projects (sorted by publishDate desc)
const allProjects = (
  await getCollection("projects", ({ data }) =>
    import.meta.env.DEV ? true : data.status !== "archived",
  )
)
  .slice()
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  );
const currentIndex = allProjects.findIndex((p) => p.slug === project.slug);
const prevProject =
  currentIndex > 0 ? allProjects[currentIndex - 1] : undefined;
const nextProject =
  currentIndex < allProjects.length - 1
    ? allProjects[currentIndex + 1]
    : undefined;
---

<Layout
  title={`${project.data.title} - Jarvis Hub`}
  lang={project.data.language}
  description={project.data.summary}
  seo={{
    canonical: canonicalUrl,
    type: "article",
    image: project.data.coverImage
      ? {
          src: project.data.coverImage,
          alt: project.data.title,
        }
      : undefined,
    publishedTime: publishDateIso,
    modifiedTime: updatedDateIso,
    tags: project.data.stack,
    structuredData: projectStructuredData,
  }}
>
  <article class="project">
    <header
      class="project__hero bg-surface/80 border border-black/5 rounded-2xl p-8 md:p-10"
    >
      <a
        class="project__breadcrumb text-sm text-secondary hover:text-primary transition-colors"
        href="/projects"
      >
        ← Back to all projects
      </a>
      <div class="project__hero-grid">
        <div class="project__hero-left">
          <div class="project__meta text-sm text-secondary">
            <span class={`status status--${project.data.status}`}
              >{project.data.status}</span
            >
            <span>{publishDate}</span>
            {
              updatedDate && (
                <>
                  <span>•</span>
                  <span>Updated {updatedDate}</span>
                </>
              )
            }
          </div>
          <h1>{project.data.title}</h1>
          <p class="project__summary text-secondary">{project.data.summary}</p>
          <div class="project__details">
            {
              project.data.roles.length > 0 && (
                <div>
                  <h2>Roles</h2>
                  <p>{project.data.roles.join(", ")}</p>
                </div>
              )
            }
            {
              project.data.stack.length > 0 && (
                <div>
                  <h2>Stack</h2>
                  <p>{project.data.stack.join(" · ")}</p>
                </div>
              )
            }
            {
              project.data.externalUrl && (
                <div>
                  <h2>Live</h2>
                  <a
                    class="project__link text-primary hover:text-accent-cyan transition-colors"
                    href={project.data.externalUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Visit project ↗
                  </a>
                </div>
              )
            }
          </div>
        </div>
        <div class="project__hero-right">
          {
            project.data.coverImage && (
              <img
                class="project__cover"
                src={project.data.coverImage}
                alt={project.data.title}
                loading="lazy"
              />
            )
          }
        </div>
      </div>
    </header>

    <section class="project__content">
      <div
        class="project__content-grid grid gap-10 items-start lg:grid-cols-[minmax(220px,240px)_minmax(0,1fr)]"
      >
        <Toc
          prefix="project"
          articleId="project-article"
          tocId="project-toc"
          ariaLabel="On-page navigation"
        />
        <div class="project__article" id="project-article">
          <div class="prose max-w-none">
            <Content />
          </div>
        </div>
      </div>
    </section>
    {
      (prevProject || nextProject) && (
        <nav
          aria-label="项目导航"
          class="grid grid-cols-1 md:grid-cols-2 gap-4"
        >
          {prevProject && (
            <a
              href={`/projects/${prevProject.slug}`}
              class="group block px-4 py-4 bg-surface border border-black/10 rounded-lg hover:border-accent-cyan transition-colors"
            >
              <div class="text-xs text-secondary uppercase mb-1">
                上一个项目
              </div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-primary font-semibold group-hover:text-accent-cyan transition-colors">
                  {prevProject.data.title}
                </h3>
                <span class="text-xs text-secondary">
                  {new Date(prevProject.data.publishDate).toLocaleDateString(
                    prevProject.data.language,
                    { year: "numeric", month: "long" },
                  )}
                </span>
              </div>
            </a>
          )}
          {nextProject && (
            <a
              href={`/projects/${nextProject.slug}`}
              class="group block px-4 py-4 bg-surface border border-black/10 rounded-lg hover:border-accent-violet transition-colors"
            >
              <div class="text-xs text-secondary uppercase mb-1">
                下一个项目
              </div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-primary font-semibold group-hover:text-accent-violet transition-colors">
                  {nextProject.data.title}
                </h3>
                <span class="text-xs text-secondary">
                  {new Date(nextProject.data.publishDate).toLocaleDateString(
                    nextProject.data.language,
                    { year: "numeric", month: "long" },
                  )}
                </span>
              </div>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Layout>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .project__hero {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .project__hero-grid {
    display: grid;
    grid-template-columns: 1.6fr 0.9fr;
    gap: 24px;
    align-items: start;
  }

  .project__hero-left,
  .project__hero-right {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .project__hero-right {
    align-items: flex-end;
  }

  .project__meta {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .project__hero h1 {
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 3.2rem);
  }

  .project__summary {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 720px;
  }

  .project__details {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .project__details h2 {
    margin: 0 0 6px;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(107, 107, 107, 0.7);
  }

  .project__details p,
  .project__link {
    margin: 0;
    text-decoration: none;
  }

  .project__cover {
    width: 100%;
    height: auto;
    border-radius: 20px;
    border: 1px solid rgba(31, 31, 31, 0.08);
    background: #ffffff;
    object-fit: cover;
    max-width: 420px;
  }

  .project__content {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .project__article {
    min-width: 0;
    max-width: 760px;
  }

  .project__article h2,
  .project__article h3 {
    scroll-margin-top: 120px;
  }

  .status {
    text-transform: capitalize;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(31, 31, 31, 0.08);
  }

  .status--launched {
    background: rgba(34, 197, 94, 0.12);
    border-color: rgba(34, 197, 94, 0.3);
    color: rgba(21, 128, 61, 0.95);
  }

  .status--in-progress {
    background: rgba(250, 204, 21, 0.12);
    border-color: rgba(250, 204, 21, 0.3);
    color: rgba(161, 98, 7, 0.95);
  }

  .status--archived {
    background: rgba(31, 31, 31, 0.05);
    border-color: rgba(31, 31, 31, 0.12);
    color: rgba(107, 107, 107, 0.9);
  }

  @media (max-width: 720px) {
    .project__hero-grid {
      grid-template-columns: 1fr;
    }

    .project__hero-right {
      align-items: stretch;
    }

    .project__cover {
      max-width: 100%;
    }

    .project__details {
      grid-template-columns: 1fr;
    }
  }
</style>
