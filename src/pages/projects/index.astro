---
import Layout from "@layouts/Layout.astro";
import { getProjects } from "@lib/content";

const projects = await getProjects({ includeArchived: false });
const description =
  "Selected work across AI-assisted tools, web platforms, and cross-platform applications.";
const siteOrigin =
  Astro.site?.origin ?? Astro.url.origin ?? "https://jarvis636431.github.io";
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();
---

<Layout
  title="Projects - Jarvis Hub"
  lang="en"
  description={description}
  decorativeBackground={false}
  seo={{
    canonical: pageUrl,
    type: "website",
    image: { src: "/logo.png", alt: "Jarvis Hub logomark" },
    structuredData: {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Jarvis Hub Projects",
      description,
      url: pageUrl,
      inLanguage: "en",
    },
  }}
>
  <div class="projects-page">
    <header class="projects-header">
      <div class="projects-heading">
        <h1>Projects</h1>
        <span
          >{projects.length}
          {projects.length === 1 ? "project" : "projects"}</span
        >
      </div>
      <p>{description}</p>
    </header>

    <section class="projects-list" aria-label="Selected projects">
      {
        projects.length === 0 && (
          <p class="projects-empty">New projects are on the way.</p>
        )
      }
      {
        projects.map((project) => {
          const title = project.data.titleEn ?? project.data.title;
          const summary = project.data.summaryEn ?? project.data.summary;
          return (
            <article
              class:list={[
                "project-entry",
                !project.data.coverImage && "project-entry--text",
              ]}
            >
              <div class="project-copy">
                <h2 lang={project.data.titleEn ? "en" : project.data.language}>
                  {title}
                </h2>
                <p
                  class="project-summary"
                  lang={project.data.summaryEn ? "en" : project.data.language}
                >
                  {summary}
                </p>
                {(project.data.externalUrl || project.data.githubUrl) && (
                  <div class="project-links" aria-label={`${title} links`}>
                    {project.data.externalUrl && (
                      <a
                        href={project.data.externalUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Visit ${title} website`}
                      >
                        Website <span aria-hidden="true">↗</span>
                      </a>
                    )}
                    {project.data.githubUrl && (
                      <a
                        class="project-github"
                        href={project.data.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${title} on GitHub`}
                      >
                        <svg
                          aria-hidden="true"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                        </svg>
                        <span>
                          {new URL(project.data.githubUrl).pathname
                            .replace(/^\/|\/$/g, "")
                            .replace(/\.git$/, "")}
                        </span>
                      </a>
                    )}
                  </div>
                )}
              </div>
              {project.data.coverImage && (
                <div class="project-identity" aria-hidden="true">
                  <img
                    src={project.data.coverImage}
                    alt=""
                    width="128"
                    height="128"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
            </article>
          );
        })
      }
    </section>
  </div>
</Layout>

<style>
  .projects-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: 3.5rem 0 2rem;
  }
  .projects-header {
    margin-bottom: 2.5rem;
  }
  .projects-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.05em;
  }
  .projects-heading > span {
    flex: none;
    color: #6b6b6b;
    font:
      0.75rem/1.5 "IBM Plex Mono",
      monospace;
  }
  .projects-header p {
    max-width: 48ch;
    margin: 1rem 0 0;
    color: #6b6b6b;
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .project-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 10rem;
    gap: 2rem;
    align-items: start;
    padding: 2rem 0;
    border-top: 1px solid #1f1f1f26;
  }
  .project-entry:last-child {
    border-bottom: 1px solid #1f1f1f26;
  }

  .project-copy {
    min-width: 0;
  }
  .project-entry--text .project-copy {
    grid-column: 1 / -1;
    max-width: 46rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    color: #2f6f6d;
    text-decoration: none;
  }
  .project-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .project-github svg {
    flex: none;
  }
  .project-github span {
    overflow-wrap: anywhere;
  }
  a:focus-visible {
    outline: 2px solid #2f6f6d;
    outline-offset: 5px;
    border-radius: 2px;
  }
  .project-summary {
    max-width: 52ch;
    margin: 0;
    color: #6b6b6b;
    font-size: 1rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .project-identity {
    display: grid;
    place-items: center;
    width: 10rem;
    aspect-ratio: 1;
    padding: 1.5rem;
    border: 1px solid #1f1f1f0d;
    border-radius: 0.75rem;
    background: #ffffff66;
  }
  .project-identity img {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }
  .projects-empty {
    padding: 2rem 0;
    color: #6b6b6b;
  }
  @media (max-width: 639px) {
    .projects-page {
      padding-top: 2.5rem;
    }
    .projects-header {
      margin-bottom: 2rem;
    }
    .projects-heading {
      gap: 0.75rem;
    }
    .projects-heading > span {
      font-size: 0.6875rem;
    }
    .project-entry {
      grid-template-columns: minmax(0, 1fr) 4rem;
      gap: 1rem;
      padding: 1.5rem 0;
    }

    .project-entry--text .project-copy {
      grid-column: 1 / -1;
    }
    .project-identity {
      width: 4rem;
      padding: 0.625rem;
      border-radius: 0.5rem;
    }

    .project-summary {
      font-size: 0.9375rem;
    }
  }
</style>
