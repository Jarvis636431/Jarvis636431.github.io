---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

// Get latest blog posts
const postsCollection = await getCollection("blog", ({ data }) => {
  return import.meta.env.DEV ? true : data.draft !== true;
});

const sortedPosts = postsCollection
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  )
  .slice(0, 3); // Show top 3 posts

const currentYear = new Date().getFullYear();
const location = {
  city: "Beijing",
  country: "CN",
  coordinates: "39.9042° N · 116.4074° E",
};
---

<style>
  .spotlight-card {
    position: relative;
    overflow: hidden;
  }

  .spotlight-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 10;
    background: radial-gradient(
      600px circle at var(--mouse-x) var(--mouse-y),
      rgba(47, 111, 109, 0.1),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .spotlight-card:hover::after {
    opacity: 1;
  }

  /* Entrance Animation */
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-card {
    opacity: 0; /* Start hidden */
    animation: enter 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .animate-card:nth-child(1) {
    animation-delay: 0.1s;
  }
  .animate-card:nth-child(2) {
    animation-delay: 0.15s;
  }
  .animate-card:nth-child(3) {
    animation-delay: 0.2s;
  }
  .animate-card:nth-child(4) {
    animation-delay: 0.25s;
  }
  .animate-card:nth-child(5) {
    animation-delay: 0.3s;
  }
  .animate-card:nth-child(6) {
    animation-delay: 0.35s;
  }
  .animate-card:nth-child(7) {
    animation-delay: 0.4s;
  }
  .animate-card:nth-child(8) {
    animation-delay: 0.45s;
  }
  .animate-card:nth-child(9) {
    animation-delay: 0.5s;
  }

  /* Grid Pattern Background */
  .bg-grid-pattern {
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
    mask-image: linear-gradient(to bottom right, black 40%, transparent 100%);
    -webkit-mask-image: linear-gradient(
      to bottom right,
      black 40%,
      transparent 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-card {
      animation: none;
    }

    .animate-card {
      opacity: 1;
      transform: none;
    }

    .spotlight-card::after {
      transition: none;
    }
  }
</style>

<Layout title="Jarvis Hub | Command Center" lang="en" viewCounterSlug="home">
  <div class="py-8 md:py-20 max-w-7xl mx-auto">
    <!-- Bento Grid Container -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 auto-rows-[minmax(180px,auto)]"
    >
      <!-- 1. Intro Card (Large, 2x2) -->
      <div
        class="animate-card spotlight-card order-1 col-span-1 md:col-span-2 lg:col-span-2 md:row-span-2 bg-surface border border-black/10 rounded-3xl p-5 md:p-8 flex flex-col justify-between relative group overflow-hidden"
      >
        <!-- Grid Background -->
        <div
          class="absolute inset-0 bg-grid-pattern opacity-100 pointer-events-none"
        >
        </div>

        <div class="space-y-8 relative z-10">
          <div class="space-y-4">
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-[1.1]"
            >
              Hi, I'm <span class="text-accent-cyan">Jarvis</span>.
            </h1>
            <p
              class="text-base md:text-lg text-secondary/80 max-w-md leading-relaxed"
            >
              Software Engineer at JD.com. <br />
              Building AI-native & cross-platform software.
            </p>
            <p
              class="font-mono text-xs uppercase tracking-wider text-secondary/60"
            >
              Beijing · Web · Mobile · AI
            </p>
          </div>
        </div>

        <div class="pt-8 flex flex-wrap items-center gap-5 relative z-10">
          <a
            href="/projects"
            class="px-6 py-3 bg-primary text-background rounded-full font-medium hover:bg-accent-cyan transition-colors"
          >
            View my work
          </a>
          <a
            href="/resume"
            class="font-medium text-secondary hover:text-primary transition-colors"
          >
            Resume →
          </a>
        </div>
      </div>

      <!-- 2. Location/Map Card (1x1) -->
      <div
        class="animate-card order-2 col-span-1 row-span-1 lg:aspect-square bg-[#242424] rounded-3xl relative group flex flex-col justify-between overflow-hidden p-5 md:p-6 text-white"
      >
        <svg
          class="absolute inset-0 h-full w-full opacity-35 transition-opacity duration-500 group-hover:opacity-55"
          viewBox="0 0 400 400"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          <defs>
            <pattern
              id="city-grid"
              width="44"
              height="44"
              patternUnits="userSpaceOnUse"
            >
              <path
                d="M 44 0 L 0 0 0 44"
                fill="none"
                stroke="white"
                stroke-opacity="0.16"
                stroke-width="1"></path>
            </pattern>
            <radialGradient id="location-glow">
              <stop offset="0" stop-color="#5eead4" stop-opacity="0.55"></stop>
              <stop offset="1" stop-color="#5eead4" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <rect width="400" height="400" fill="url(#city-grid)"></rect>
          <g fill="none" stroke="white" stroke-opacity="0.3" stroke-width="3">
            <path d="M-20 105 C80 75 125 155 220 126 S335 65 430 104"></path>
            <path d="M-10 292 C92 260 115 202 213 226 S318 325 420 276"></path>
            <path d="M92-20 C120 72 84 152 132 222 S175 326 152 430"></path>
            <path d="M300-20 C263 85 330 145 277 226 S245 329 292 430"></path>
          </g>
          <circle cx="215" cy="196" r="72" fill="url(#location-glow)"></circle>
          <circle cx="215" cy="196" r="8" fill="#5eead4"></circle>
          <circle
            cx="215"
            cy="196"
            r="15"
            fill="none"
            stroke="#5eead4"
            stroke-opacity="0.7"
            stroke-width="2"></circle>
        </svg>
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"
        >
        </div>
        <div class="relative z-10">
          <p class="text-xs font-mono uppercase tracking-widest text-white/60">
            Based in
          </p>
        </div>
        <div class="relative z-10">
          <h3 class="text-2xl font-display font-bold">
            {location.city}, {location.country}
          </h3>
          <p class="text-[10px] font-mono text-white/40">
            {location.coordinates}
          </p>
          <p id="local-time" class="text-sm font-mono text-white/60 mt-1">
            --:-- --
          </p>
        </div>
      </div>

      <!-- 3. Music/Vibe Card (1x1) -->
      <div
        class="animate-card order-3 col-span-1 row-span-1 lg:aspect-square bg-[#1DB954]/10 border border-[#1DB954]/20 rounded-3xl p-5 md:p-6 flex flex-col justify-between group hover:border-[#1DB954]/40 transition-colors relative overflow-hidden"
      >
        <div class="flex justify-between items-start z-10">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-8 h-8 text-[#1DB954]"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.586 14.424c-.188.309-.586.411-.894.223-2.449-1.496-5.534-1.833-9.168-1.004-.339.077-.678-.142-.755-.481-.077-.339.142-.678.481-.755 4.032-.919 7.494-.523 10.314 1.2.308.188.411.586.223.894zm1.28-2.849c-.237.385-.738.511-1.123.274-2.812-1.728-7.1-2.231-10.426-1.221-.434.132-.893-.119-1.025-.553-.132-.434.119-.893.553-1.025 3.844-1.166 8.653-.598 11.903 1.402.385.237.511.738.274 1.123zm.116-3.037c-3.37-2.001-8.928-2.185-12.146-1.209-.508.154-1.045-.135-1.199-.643-.154-.508.135-1.045.643-1.199 3.733-1.132 9.873-.919 13.785 1.404.463.275.614.877.34 1.34-.275.463-.877.614-1.34.34z"
            ></path>
          </svg>
          <div class="flex gap-1 items-end h-6">
            <span class="w-1 h-2 bg-[#1DB954] block rounded-full"></span>
            <span class="w-1 h-5 bg-[#1DB954] block rounded-full"></span>
            <span class="w-1 h-3 bg-[#1DB954] block rounded-full"></span>
          </div>
        </div>
        <div class="z-10">
          <p class="font-mono text-xs text-[#1DB954]/80 mb-1">On Repeat</p>
          <p class="font-display font-bold text-[#1DB954] leading-tight">
            Coding Vibes
          </p>
        </div>
      </div>

      <!-- 4. Recent Writing -->
      <section
        class="animate-card order-5 col-span-1 md:col-span-3 lg:col-span-4 py-4 md:py-8"
        aria-labelledby="recent-writing-title"
      >
        <div class="mb-6 flex items-end justify-between gap-6">
          <div>
            <p
              class="mb-2 font-mono text-[11px] uppercase tracking-[0.18em] text-secondary/60"
            >
              Notes & learnings
            </p>
            <h2
              id="recent-writing-title"
              class="font-display text-2xl md:text-3xl font-bold"
            >
              Recent Writing
            </h2>
          </div>
          <a
            href="/blogs"
            class="shrink-0 text-sm font-medium text-accent-cyan hover:text-primary transition-colors"
          >
            View all →
          </a>
        </div>

        <div
          class="grid divide-y divide-black/10 border-y border-black/10 lg:grid-cols-3 lg:divide-x lg:divide-y-0"
        >
          {
            sortedPosts.map((post) => (
              <a
                href={`/blogs/${post.slug}`}
                class="group flex min-h-48 flex-col py-6 lg:px-6 lg:first:pl-0 lg:last:pr-0"
              >
                <div class="mb-5 flex items-center justify-between gap-3 text-[11px] font-mono text-secondary/60">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {new Date(post.data.publishDate).toLocaleDateString(
                      post.data.language,
                      {
                        month: "short",
                        day: "numeric",
                      },
                    )}
                  </time>
                  <span>{post.data.readingTime ?? 6} min</span>
                </div>
                <h3 class="font-display text-lg font-semibold text-primary group-hover:text-accent-cyan transition-colors leading-snug line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-secondary line-clamp-3">
                  {post.data.description}
                </p>
                <div class="mt-auto flex items-end justify-between gap-3 pt-5">
                  <span class="truncate font-mono text-[11px] text-secondary/60">
                    {post.data.tags[0] ?? "Note"}
                  </span>
                  <span class="text-accent-cyan transition-transform group-hover:translate-x-0.5">
                    →
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <!-- 5. Contribution Heatmap -->
      <a
        href="https://github.com/Jarvis636431"
        target="_blank"
        rel="noopener noreferrer"
        class="animate-card order-4 col-span-1 md:col-span-3 lg:col-span-2 bg-surface border border-black/10 rounded-3xl p-4 md:p-5 flex flex-col relative group overflow-hidden hover:border-black/20 transition-colors"
      >
        <div class="mb-2 flex items-center justify-between gap-5">
          <h3 class="font-display text-sm font-semibold">Contributions</h3>
          <div
            class="flex items-center gap-3 text-[11px] font-mono text-secondary/60"
          >
            <span>{currentYear}</span>
            <span class="transition-transform group-hover:translate-x-0.5"
              >↗</span
            >
          </div>
        </div>

        <div class="flex min-h-0 flex-1 items-center overflow-hidden">
          <img
            src="https://ghchart.rshah.org/2f6f6d/Jarvis636431"
            alt="Jarvis636431's Github Chart"
            class="h-auto w-full scale-[1.03] opacity-80 transition-opacity group-hover:opacity-100"
          />
        </div>
      </a>
    </div>
  </div>
</Layout>

<script>
  // Update local time for Beijing (UTC+8)
  function updateTime() {
    const timeDisplay = document.getElementById("local-time");
    if (timeDisplay) {
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = {
        timeZone: "Asia/Shanghai",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      };
      const timeString = now.toLocaleTimeString("en-US", options);
      timeDisplay.textContent = timeString + " UTC+8";
    }
  }

  setInterval(updateTime, 60_000);
  updateTime();

  // View Counter Logic
  async function initViewCounter() {
    const container = document.getElementById("footer-view-count");
    const pageSlug = container?.dataset.viewCounterSlug;
    if (!pageSlug) return;

    const { supabase } = await import("../lib/supabase");
    if (!supabase) return;

    const viewCountEl = document.getElementById("view-count-value");

    try {
      // Increment view count using RPC
      const { data: newCount, error } = await supabase.rpc(
        "increment_page_view",
        {
          page_slug: pageSlug,
        },
      );

      if (!error && newCount !== null) {
        if (viewCountEl) viewCountEl.innerText = newCount.toLocaleString();
        if (container) container.classList.remove("opacity-0");
      }
    } catch (e) {
      console.error("Error updating view count:", e);
    }
  }

  setTimeout(initViewCounter, 1200);
</script>
