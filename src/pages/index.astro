---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getPostReadingTime } from "@lib/blog";

const posts = (
  await getCollection("blog", ({ data }) =>
    import.meta.env.DEV ? true : data.draft !== true,
  )
)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const projects = (
  await getCollection(
    "projects",
    ({ data }) => data.featured && data.status !== "archived",
  )
)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<Layout
  title="Jarvis Hub | Software Engineer"
  description="我是 Jarvis，京东软件工程师。这里记录我的跨端应用、AI 工具、开源实践与技术笔记。"
  lang="zh-CN"
  viewCounterSlug="home"
  decorativeBackground={false}
>
  <div class="home">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <h1 id="intro-title">Hi, I'm <span>Jarvis</span>.</h1>
        <p class="intro-description">Tianjin University - Joybuy</p>
        <nav class="intro-links" aria-label="了解更多">
          <a href="#selected-projects">项目 ↘</a>
          <a href="#recent-writing">文章 ↘</a>
          <a href="/about">关于我 →</a>
        </nav>
      </div>

      <div class="contributions" aria-labelledby="contributions-title">
        <div class="contributions-heading">
          <h2 id="contributions-title">GitHub Contributions</h2>
          <a
            href="https://github.com/Jarvis636431"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="访问 Jarvis 的 GitHub">GitHub ↗</a
          >
        </div>
        <div
          id="contribution-scroll"
          class="contribution-scroll"
          role="region"
          aria-label="GitHub 贡献热力图，可左右滚动"
          tabindex="0"
        >
          <img
            src="https://ghchart.rshah.org/2f6f6d/Jarvis636431"
            alt="Jarvis636431 过去一年的 GitHub 贡献热力图"
            width="722"
            height="112"
          />
        </div>
      </div>
    </section>

    <section
      id="selected-projects"
      class="content-section"
      aria-labelledby="projects-title"
      data-reveal
    >
      <div class="section-heading">
        <h2 id="projects-title">精选项目</h2>
        <a href="/projects">全部项目 →</a>
      </div>
      <div class="project-list">
        {
          projects.map((project, index) => (
            <a class="project-row" href={`/projects/${project.slug}`}>
              <span class="project-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="project-copy">
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
                <span class="project-stack">
                  {project.data.stack.join(" / ")}
                </span>
              </div>
              <span class="entry-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section
      id="recent-writing"
      class="content-section"
      aria-labelledby="writing-title"
      data-reveal
    >
      <div class="section-heading">
        <h2 id="writing-title">最近文章</h2>
        <a href="/blogs">全部文章 →</a>
      </div>
      <div class="writing-list">
        {
          posts.map((post) => (
            <a class="writing-row" href={`/blogs/${post.slug}`}>
              <time datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString("zh-CN", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                  timeZone: "Asia/Shanghai",
                })}
              </time>
              <div class="writing-copy">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="reading-time">
                  {getPostReadingTime(post)} 分钟阅读
                </span>
              </div>
              <span class="entry-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
        {
          posts.length === 0 && (
            <p class="empty-state">文章正在整理中，稍后再来看看。</p>
          )
        }
      </div>
    </section>
  </div>
</Layout>

<style>
  .home {
    padding-bottom: 2rem;
  }
  .intro {
    min-height: calc(100svh - 74px);
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding: 5rem 0 7rem;
  }
  .intro > * {
    min-width: 0;
  }
  .project-number,
  .project-stack,
  time,
  .reading-time {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    color: #6b6b6b;
  }
  .intro h1 {
    font-size: clamp(2.75rem, 4.5vw, 4rem);
    line-height: 1.15;
    letter-spacing: 0;
  }
  .intro h1 span {
    color: #2f6f6d;
  }
  .intro-description {
    margin-top: 1.5rem;
    color: #6b6b6b;
    font-size: 1.125rem;
    line-height: 1.9;
  }
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2rem;
    font-size: 0.875rem;
  }
  a {
    transition: color 180ms ease;
  }
  a:hover {
    color: #2f6f6d;
  }
  a:focus-visible,
  .contribution-scroll:focus-visible {
    outline: 2px solid #2f6f6d;
    outline-offset: 6px;
  }
  .contributions-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .contributions-heading h2,
  .contributions-heading a {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
    color: #6b6b6b;
  }
  .contributions-heading a:hover {
    color: #2f6f6d;
  }
  .contribution-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #1f1f1f26 transparent;
  }
  .contribution-scroll img {
    display: block;
    width: 100%;
    min-width: 440px;
    height: auto;
    max-width: none;
  }
  .content-section {
    padding: 2rem 0 4rem;
    scroll-margin-top: 6rem;
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .section-heading h2 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .section-heading > a {
    font-size: 0.875rem;
    color: #6b6b6b;
    white-space: nowrap;
  }
  .project-list,
  .writing-list {
    border-top: 1px solid #1f1f1f1a;
  }
  .project-row,
  .writing-row {
    display: grid;
    align-items: start;
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid #1f1f1f1a;
  }
  .project-row {
    grid-template-columns: 3rem minmax(0, 1fr) 1.5rem;
  }
  .writing-row {
    grid-template-columns: 8rem minmax(0, 1fr) 1.5rem;
  }
  .project-number,
  time {
    padding-top: 0.35rem;
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
    transition: color 180ms ease;
  }
  .project-row:hover h3,
  .writing-row:hover h3 {
    color: #2f6f6d;
  }
  .project-copy p,
  .writing-copy p {
    margin-top: 0.5rem;
    color: #6b6b6b;
    font-size: 0.9375rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .project-stack,
  .reading-time {
    display: block;
    margin-top: 1rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .entry-arrow {
    padding-top: 0.25rem;
    color: #6b6b6b;
    transition:
      transform 250ms ease,
      color 180ms ease;
  }
  a:hover .entry-arrow {
    transform: translate(2px, -2px);
    color: #2f6f6d;
  }
  .empty-state {
    padding: 2rem 0;
    color: #6b6b6b;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-reveal].reveal-pending {
      opacity: 0;
      transform: translateY(18px);
    }
    [data-reveal] {
      transition:
        opacity 600ms ease,
        transform 600ms ease;
    }
  }
  @media (max-width: 767px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      gap: 3.5rem;
      min-height: calc(100svh - 74px);
      padding: 3.5rem 0;
    }
    .intro-description {
      font-size: 1rem;
    }
    .contributions {
      padding-bottom: 1rem;
    }
    .contributions-heading {
      margin-bottom: 1rem;
    }
    .content-section {
      padding-bottom: 2.5rem;
    }
    .project-row {
      grid-template-columns: 1.5rem minmax(0, 1fr) 1rem;
      gap: 1rem;
    }
    .writing-row {
      grid-template-columns: minmax(0, 1fr) 1rem;
      gap: 0.5rem 1rem;
    }
    .writing-row time {
      grid-column: 1;
      padding: 0;
    }
    .writing-copy {
      grid-column: 1;
    }
    .writing-row .entry-arrow {
      grid-column: 2;
      grid-row: 2;
    }
    h3 {
      font-size: 1.125rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    a,
    h3,
    .entry-arrow {
      transition: none;
    }
    a:hover .entry-arrow {
      transform: none;
    }
  }
</style>

<script>
  const contributionScroll = document.getElementById("contribution-scroll");
  const chart = contributionScroll?.querySelector("img");
  const showRecentWeeks = () => {
    if (contributionScroll)
      contributionScroll.scrollLeft =
        contributionScroll.scrollWidth - contributionScroll.clientWidth;
  };
  if (chart?.complete) showRecentWeeks();
  else chart?.addEventListener("load", showRecentWeeks, { once: true });

  if (
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("reveal-pending");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08 },
    );
    document
      .querySelectorAll<HTMLElement>("[data-reveal]")
      .forEach((section) => {
        if (section.getBoundingClientRect().top >= window.innerHeight) {
          section.classList.add("reveal-pending");
          observer.observe(section);
        }
      });
  }

  // View Counter Logic
  async function initViewCounter() {
    const container = document.getElementById("footer-view-count");
    const pageSlug = container?.dataset.viewCounterSlug;
    if (!pageSlug) return;

    const { supabase } = await import("../lib/supabase");
    if (!supabase) return;

    const viewCountEl = document.getElementById("view-count-value");

    try {
      // Increment view count using RPC
      const { data: newCount, error } = await supabase.rpc(
        "increment_page_view",
        {
          page_slug: pageSlug,
        },
      );

      if (!error && newCount !== null) {
        if (viewCountEl) viewCountEl.innerText = newCount.toLocaleString();
        if (container) container.classList.remove("opacity-0");
      }
    } catch (e) {
      console.error("Error updating view count:", e);
    }
  }

  setTimeout(initViewCounter, 1200);
</script>
